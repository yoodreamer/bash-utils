#!/usr/bin/env bash

function cmd_table() {
    local ESC=$'\e'

    function die() {
        printf '%s\n' "${ESC}[31m[!] Error: $1${ESC}[0m" >&2
        exit 1
    }

    function strip_ansi() {
        local input
        if [[ $# -gt 0 ]]; then
            input="$*"
        else
            IFS= read -r -d '' input
        fi

        local out=""
        local -i state=0 
        local -r ESC_CHAR=$'\x1b'
        local -r BEL=$'\x07'
        local -i i len=${#input}
        local c

        for (( i=0; i<len; i++ )); do
            c="${input:i:1}"
            case "$state" in
                0) case "$c" in
                       "$ESC_CHAR") state=1 ;;
                       "$BEL") : ;;
                       *) out+="$c" ;;
                   esac ;;
                1) case "$c" in
                       '[') state=2 ;;
                       ']') state=3 ;;
                       '%'|'('|')'|'0'|'3'|'5'|'6'|'#') state=5 ;;
                       "$BEL"|'A'|'B'|'C'|'D'|'E'|'H'|'I'|'J'|'K'|'M'|'N'|'O'|'S'|'T'|'Z'|'c'|'s'|'u'|'1'|'2'|'7'|'8'|'<'|'='|'>') state=0 ;;
                       *) out+="${ESC_CHAR}${c}"; state=0 ;;
                   esac ;;
                2) case "$c" in
                       ';'|'?'|[0-9]) : ;;
                       *) state=0 ;;
                   esac ;;
                3) case "$c" in
                       [0-9]) state=4 ;;
                       *) state=0 ;;
                   esac ;;
                4) case "$c" in
                       "$BEL") state=0 ;;
                       "$ESC_CHAR") state=5 ;;
                   esac ;;
                5) state=0 ;;
            esac
        done
        printf '%s' "$out"
    }

    local _CSS_COLORS_INIT=0
    function _css_init() {
        [[ $_CSS_COLORS_INIT -eq 1 ]] && return
        declare -gA _CSS_COLORS=(
            [aliceblue]=f0f8ff [antiquewhite]=faebd7 [aqua]=00ffff [aquamarine]=7fffd4
            [azure]=f0ffff [beige]=f5f5dc [bisque]=ffe4c4 [black]=000000
            [blanchedalmond]=ffebcd [blue]=0000ff [blueviolet]=8a2be2 [brown]=a52a2a
            [burlywood]=deb887 [cadetblue]=5f9ea0 [chartreuse]=7fff00 [chocolate]=d2691e
            [coral]=ff7f50 [cornflowerblue]=6495ed [cornsilk]=fff8dc [crimson]=dc143c
            [cyan]=00ffff [darkblue]=00008b [darkcyan]=008b8b [darkgoldenrod]=b8860b
            [darkgray]=a9a9a9 [darkgreen]=006400 [darkgrey]=a9a9a9 [darkkhaki]=bdb76b
            [darkmagenta]=8b008b [darkolivegreen]=556b2f [darkorange]=ff8c00 [darkorchid]=9932cc
            [darkred]=8b0000 [darksalmon]=e9967a [darkseagreen]=8fbc8f [darkslateblue]=483d8b
            [darkslategray]=2f4f4f [darkslategrey]=2f4f4f [darkturquoise]=00ced1 [darkviolet]=9400d3
            [deeppink]=ff1493 [deepskyblue]=00bfff [dimgray]=696969 [dimgrey]=696969
            [dodgerblue]=1e90ff [firebrick]=b22222 [floralwhite]=fffaf0 [forestgreen]=228b22
            [fuchsia]=ff00ff [gainsboro]=dcdcdc [ghostwhite]=f8f8ff [gold]=ffd700
            [goldenrod]=daa520 [gray]=808080 [green]=008000 [greenyellow]=adff2f
            [grey]=808080 [honeydew]=f0fff0 [hotpink]=ff69b4 [indianred]=cd5c5c
            [indigo]=4b0082 [ivory]=fffff0 [khaki]=f0e68c [lavender]=e6e6fa
            [lavenderblush]=fff0f5 [lawngreen]=7cfc00 [lemonchiffon]=fffacd [lightblue]=add8e6
            [lightcoral]=f08080 [lightcyan]=e0ffff [lightgoldenrodyellow]=fafad2 [lightgray]=d3d3d3
            [lightgreen]=90ee90 [lightgrey]=d3d3d3 [lightpink]=ffb6c1 [lightsalmon]=ffa07a
            [lightseagreen]=20b2aa [lightskyblue]=87cefa [lightslategray]=778899 [lightslategrey]=778899
            [lightsteelblue]=b0c4de [lightyellow]=ffffe0 [lime]=00ff00 [limegreen]=32cd32
            [linen]=faf0e6 [magenta]=ff00ff [maroon]=800000 [mediumaquamarine]=66cdaa
            [mediumblue]=0000cd [mediumorchid]=ba55d3 [mediumpurple]=9370db [mediumseagreen]=3cb371
            [mediumslateblue]=7b68ee [mediumspringgreen]=00fa9a [mediumturquoise]=48d1cc [mediumvioletred]=c71585
            [midnightblue]=191970 [mintcream]=f5fffa [mistyrose]=ffe4e1 [moccasin]=ffe4b5
            [navajowhite]=ffdead [navy]=000080 [oldlace]=fdf5e6 [olive]=808000
            [olivedrab]=6b8e23 [orange]=ffa500 [orangered]=ff4500 [orchid]=da70d6
            [palegoldenrod]=eee8aa [palegreen]=98fb98 [paleturquoise]=afeeee [palevioletred]=db7093
            [papayawhip]=ffefd5 [peachpuff]=ffdab9 [peru]=cd853f [pink]=ffc0cb
            [plum]=dda0dd [powderblue]=b0e0e6 [purple]=800080 [rebeccapurple]=663399
            [red]=ff0000 [rosybrown]=bc8f8f [royalblue]=4169e1 [saddlebrown]=8b4513
            [salmon]=fa8072 [sandybrown]=f4a460 [seagreen]=2e8b57 [seashell]=fff5ee
            [sienna]=a0522d [silver]=c0c0c0 [skyblue]=87ceeb [slateblue]=6a5acd
            [slategray]=708090 [slategrey]=708090 [snow]=fffafa [springgreen]=00ff7f
            [steelblue]=4682b4 [tan]=d2b48c [teal]=008080 [thistle]=d8bfd8
            [tomato]=ff6347 [turquoise]=40e0d0 [violet]=ee82ee [wheat]=f5deb3
            [white]=ffffff [whitesmoke]=f5f5f5 [yellow]=ffff00 [yellowgreen]=9acd32
        )
        _CSS_COLORS_INIT=1
    }

    function _list_color_names() {
        _css_init
        local names=(
            black red green yellow blue magenta purple cyan white gray grey
            brightblack brightred brightgreen brightyellow brightblue
            brightmagenta brightpurple brightcyan brightwhite none clear
        )
        names+=("${!_CSS_COLORS[@]}")
        printf '%s\n' "${names[@]}" | sort -u | paste -sd, - | sed 's/,/, /g'
    }

    function is_valid_color() {
        local val="${1,,}"
        [[ "$val" == "none" || "$val" == "clear" ]] && return 0
        [[ "$val" =~ ^#([a-fA-F0-9]{6}|[a-fA-F0-9]{3})$ ]] && return 0
        [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 0 && val <= 255 )) && return 0
        case "$val" in
            black|red|green|yellow|blue|magenta|purple|cyan|white|gray|grey) return 0 ;;
            brightblack|brightred|brightgreen|brightyellow|brightblue|brightmagenta|brightpurple|brightcyan|brightwhite) return 0 ;;
        esac
        _css_init
        [[ -n "${_CSS_COLORS[$val]:-}" ]] && return 0
        return 1
    }

    function strict_bool() {
        local val="${1,,}"
        case "$val" in
            true|1|yes) printf "true" ;;
            false|0|no) printf "false" ;;
            *) printf "INVALID" ;;
        esac
    }

    function resolve_color() {
        local val="${1,,}"
        [[ -z "$val" ]] && return
        if [[ "$val" == \#* ]]; then
            echo "$val"; return
        fi
        case "$val" in
            black) echo "0" ;; red) echo "1" ;; green) echo "2" ;; yellow) echo "3" ;; blue) echo "4" ;;
            magenta|purple) echo "5" ;; cyan) echo "6" ;; white) echo "7" ;;
            brightblack|gray|grey) echo "8" ;; brightred) echo "9" ;; brightgreen) echo "10" ;;
            brightyellow) echo "11" ;; brightblue) echo "12" ;; brightmagenta|brightpurple) echo "13" ;;
            brightcyan) echo "14" ;; brightwhite) echo "15" ;;
            *)
                if [[ "$val" =~ ^[0-9]+$ ]]; then
                    echo "$val"
                else
                    _css_init
                    local hex="${_CSS_COLORS[$val]:-}"
                    if [[ -n "$hex" ]]; then
                        echo "#$hex"
                    else
                        echo "$val"
                    fi
                fi
                ;;
        esac
    }

    function make_ansi() {
        local fg=$1; local bg=$2; local attr=$3; local seq=""
        [[ -n "$attr" ]] && seq+="${ESC}[${attr}m"
        
        if [[ -n "$fg" && "$fg" != "none" && "$fg" != "clear" ]]; then
            local c_fg="$(resolve_color "$fg")"
            if [[ "$c_fg" == \#* ]]; then
                local hex="${c_fg#\#}"
                [[ ${#hex} -eq 3 ]] && hex="${hex:0:1}${hex:0:1}${hex:1:1}${hex:1:1}${hex:2:1}${hex:2:1}"
                local r=$(( 16#${hex:0:2} )); local g=$(( 16#${hex:2:2} )); local b=$(( 16#${hex:4:2} ))
                seq+="${ESC}[38;2;${r};${g};${b}m"
            else
                seq+="${ESC}[38;5;${c_fg}m"
            fi
        fi

        if [[ -n "$bg" && "$bg" != "none" && "$bg" != "clear" ]]; then
            local c_bg="$(resolve_color "$bg")"
            if [[ "$c_bg" == \#* ]]; then
                local hex="${c_bg#\#}"
                [[ ${#hex} -eq 3 ]] && hex="${hex:0:1}${hex:0:1}${hex:1:1}${hex:1:1}${hex:2:1}${hex:2:1}"
                local r=$(( 16#${hex:0:2} )); local g=$(( 16#${hex:2:2} )); local b=$(( 16#${hex:4:2} ))
                seq+="${ESC}[48;2;${r};${g};${b}m"
            else
                seq+="${ESC}[48;5;${c_bg}m"
            fi
        fi
        
        printf '%s' "$seq"
    }

    function show_help_panel() {
        cat <<EOF
Usage: bash-utils table [flags]

Render a boxed table of data using AWK. When stdout is a terminal, the
table becomes interactive: navigate rows and scroll columns. Data is read from STDIN.

Flags:
  -h, --help                Show help
  -s, --separator=","       Separator character
  -c, --columns="A,B,C"     Column titles (If omitted, first row is used as header)
  --align="left"            Table alignment (left, center, right)
  --height=10               Max visible data rows in interactive mode (integer > 0)

  # Borders
  --border.type="rounded"   Type: normal, rounded, thick, double, hidden
  --border.style="default"  Style: default, rows, mdcat
  --border-foreground=240   Border foreground color (Name (incl. CSS names like 'coral'), Hex, 0-255, none/clear)
  --border-background=""    Border background color

  # Styles
  --header-foreground=""    Header text color
  --header-background=""    Header bg color
  --foreground=""           Cell text color
  --background=""           Cell bg color

  # Attributes (Boolean)
  --header.bold, --header.italic, --header.underline, --header.strikethrough, --header.faint
  --foreground.bold, --foreground.italic, --foreground.underline, --foreground.strikethrough, --foreground.faint

  # Interactive selection (auto-enabled when stdout is a terminal and there is >=1 data row)
  --selected-foreground=212 Selected row text color
  --selected-background=none Selected row bg color
  --print                   Print the full table and exit immediately, no key wait
                             (no --print: enters the interactive selector)

  Keys while interactive:
    ↑/k  up          ↓/j  down
    ←    scroll cols left   →  scroll cols right (only when columns don't fit)
    Enter/q/Esc  exit the selector

EOF
    }

    local separator=","
    local columns=""
    local align="left"
    local border_type="rounded"
    local border_style="default"
    local height=10
    
    local border_fg="240"; local border_bg=""
    local header_fg=""; local header_bg=""
    local cell_fg="";      local cell_bg=""
    local sel_fg="212";    local sel_bg="none"

    local print_selection="false"
    
    local h_bold="true";  local h_faint="false"; local h_italic="false"; local h_underline="false"; local h_strike="false"
    local c_bold="false"; local c_faint="false"; local c_italic="false"; local c_underline="false"; local c_strike="false"

    local parse_args=()
    
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == --*=* ]]; then
            parse_args+=("${1%%=*}" "${1#*=}")
        else
            parse_args+=("$1")
        fi
        shift
    done
    set -- "${parse_args[@]}"

    while [[ $# -gt 0 ]]; do
        local key="$1"
        local val=""
        local has_val="false"

        if [[ "$key" == *=* ]]; then
            val="${key#*=}"
            key="${key%%=*}"
            has_val="true"
        fi

        if [[ "$key" =~ ^--(header|foreground)\.(bold|faint|italic|underline|strikethrough)$ ]]; then
            local comp="${BASH_REMATCH[1]}"
            local prop="${BASH_REMATCH[2]}"
            [[ "$comp" == "foreground" ]] && comp="c"
            [[ "$comp" == "header" ]] && comp="h"
            [[ "$prop" == "strikethrough" ]] && prop="strike"

            if [[ "$has_val" == "true" ]]; then
                local bval=$(strict_bool "$val")
                [[ "$bval" == "INVALID" ]] && die "Valor booleano inválido en '${key}'. Recibido: '${val}'."
                eval "${comp}_${prop}=\"${bval}\""
            else
                if [[ $# -ge 2 && ! "$2" == --* ]]; then 
                    local bval=$(strict_bool "$2")
                    if [[ "$bval" != "INVALID" ]]; then
                        eval "${comp}_${prop}=\"${bval}\""
                        shift 2
                        continue
                    fi
                fi
                eval "${comp}_${prop}=\"true\""
            fi
            shift; continue
        fi

        case "$key" in
            -h|--help) show_help_panel; return 0 ;;
            --print) print_selection="true"; shift ;;
            
            -s|--separator|-c|--columns|--align|--border.type|--border|--border.style|--border-foreground|--border-background|--header-foreground|--header-background|--foreground|--background|--selected-foreground|--selected-background|--height)
                if [[ "$has_val" == "false" ]]; then
                    if [[ $# -lt 2 || "$2" == --* ]]; then
                        die "La bandera '${key}' requiere un valor asignado."
                    fi
                    val="$2"
                    shift 2
                else
                    shift
                fi

                case "$key" in
                    -s|--separator) separator="$val" ;;
                    -c|--columns)   columns="$val" ;;
                    --align)
                        case "${val,,}" in
                            left|center|right) align="${val,,}" ;;
                            *) die "Alineación inválida en '${key}'. Literales: left, center, right." ;;
                        esac ;;
                    --border.type|--border)
                        case "${val,,}" in
                            normal|rounded|thick|double|hidden) border_type="${val,,}" ;;
                            *) die "Borde inválido en '${key}'. Literales: normal, rounded, thick, double, hidden." ;;
                        esac ;;
                    --border.style)
                        case "${val,,}" in
                            default|rows|mdcat) border_style="${val,,}" ;;
                            *) die "Estilo de borde inválido en '${key}'. Literales: default, rows, mdcat." ;;
                        esac ;;
                    --height)
                        [[ ! "$val" =~ ^[1-9][0-9]*$ ]] && die "El valor para '--height' es inválido.\n  Recibido: '${val}'\n  Tipo Literal: Entero positivo (ej. 10, 15)."
                        height="$val"
                        ;;
                    
                    --border-foreground|--border-background|--header-foreground|--header-background|--foreground|--background|--selected-foreground|--selected-background)
                        if ! is_valid_color "$val"; then
                            die "Color inválido en '${key}'. Recibido: '${val}'. Colores disponibles: $(_list_color_names)"
                        fi
                        case "$key" in
                            --border-foreground)   border_fg="$val" ;;
                            --border-background)   border_bg="$val" ;;
                            --header-foreground)   header_fg="$val" ;;
                            --header-background)   header_bg="$val" ;;
                            --foreground)          cell_fg="$val" ;;
                            --background)          cell_bg="$val" ;;
                            --selected-foreground) sel_fg="$val" ;;
                            --selected-background) sel_bg="$val" ;;
                        esac
                        ;;
                esac
                ;;

            -*) die "Bandera desconocida o no soportada: '${key}'." ;;
            *)  shift ;; 
        esac
    done

    if [ -t 0 ]; then
        return 0
    fi
    
    local raw_content
    raw_content=$(cat)
    [[ -z "$raw_content" ]] && return 0

    declare -A B_NORM=( [tl]="┌" [t]="─" [tr]="┐" [tm]="┬" [l]="│" [m]="│" [r]="│" [ml]="├" [h]="─" [mm]="┼" [mr]="┤" [bl]="└" [b]="─" [br]="┘" [bm]="┴" )
    declare -A B_RND=(  [tl]="╭" [t]="─" [tr]="╮" [tm]="┬" [l]="│" [m]="│" [r]="│" [ml]="├" [h]="─" [mm]="┼" [mr]="┤" [bl]="╰" [b]="─" [br]="╯" [bm]="┴" )
    declare -A B_THICK=([tl]="┏" [t]="━" [tr]="┓" [tm]="┳" [l]="┃" [m]="┃" [r]="┃" [ml]="┣" [h]="━" [mm]="╋" [mr]="┫" [bl]="┗" [b]="━" [br]="┛" [bm]="┻" )
    declare -A B_DBL=(  [tl]="╔" [t]="═" [tr]="╗" [tm]="╦" [l]="║" [m]="║" [r]="║" [ml]="╠" [h]="═" [mm]="╬" [mr]="╣" [bl]="╚" [b]="═" [br]="╝" [bm]="╩" )
    declare -A B_HID=(  [tl]=" " [t]=" " [tr]=" " [tm]=" " [l]=" " [m]=" " [r]=" " [ml]=" " [h]=" " [mm]=" " [mr]=" " [bl]=" " [b]=" " [br]=" " [bm]=" " )

    local -n B
    case "$border_type" in
        normal) B=B_NORM ;;
        thick)  B=B_THICK ;;
        double) B=B_DBL ;;
        hidden) B=B_HID ;;
        *)      B=B_RND ;; 
    esac

    local attr_h=""
    [[ "$h_bold" == "true" ]] && attr_h+="1;"
    [[ "$h_faint" == "true" ]] && attr_h+="2;"
    [[ "$h_italic" == "true" ]] && attr_h+="3;"
    [[ "$h_underline" == "true" ]] && attr_h+="4;"
    [[ "$h_strike" == "true" ]] && attr_h+="9;"
    attr_h="${attr_h%;}"

    local attr_c=""
    [[ "$c_bold" == "true" ]] && attr_c+="1;"
    [[ "$c_faint" == "true" ]] && attr_c+="2;"
    [[ "$c_italic" == "true" ]] && attr_c+="3;"
    [[ "$c_underline" == "true" ]] && attr_c+="4;"
    [[ "$c_strike" == "true" ]] && attr_c+="9;"
    attr_c="${attr_c%;}"

    local s_head_bg=$(make_ansi "" "$header_bg" "")
    local s_head_txt=$(make_ansi "$header_fg" "" "$attr_h")
    local s_cell_bg=$(make_ansi "" "$cell_bg" "")
    local s_cell_txt=$(make_ansi "$cell_fg" "" "$attr_c")
    local s_border=$(make_ansi "$border_fg" "$border_bg" "")
    local s_sel_bg=$(make_ansi "" "$sel_bg" "")
    local s_sel_txt=$(make_ansi "$sel_fg" "" "1")
    local reset="${ESC}[0m"

    local term_cols
    term_cols=$(stty size 2>/dev/null </dev/tty | awk '{print $2}')
    : "${term_cols:=${COLUMNS:-$(tput cols 2>/dev/null)}}"
    : "${term_cols:=80}"
    [[ "$term_cols" =~ ^[0-9]+$ ]] || term_cols=80

    function render_frame() {
        local sel_row="${1:-0}"
        local win_offset="${2:-0}"
        local win_height="${3:-0}"
        local col_offset="${4:-0}"
        local meta_file="${5:-}"
        printf '%s\n' "$raw_content" | awk -F "$separator" \
            -v COLUMNS_STR="$columns" \
            -v ALIGN="$align" \
            -v BORDER_STYLE="$border_style" \
            -v TERM_COLS="$term_cols" \
            -v SEL_ROW="$sel_row" \
            -v WIN_OFFSET="$win_offset" \
            -v WIN_HEIGHT="$win_height" \
            -v COL_OFFSET="$col_offset" \
            -v META_FILE="$meta_file" \
            -v S_BORDER="$s_border" \
            -v S_HEAD_BG="$s_head_bg" \
            -v S_HEAD_TXT="$s_head_txt" \
            -v S_CELL_BG="$s_cell_bg" \
            -v S_CELL_TXT="$s_cell_txt" \
            -v S_SEL_BG="$s_sel_bg" \
            -v S_SEL_TXT="$s_sel_txt" \
            -v RESET="$reset" \
            -v B_TL="${B[tl]}" -v B_T="${B[t]}" -v B_TR="${B[tr]}" -v B_TM="${B[tm]}" \
            -v B_L="${B[l]}"   -v B_M="${B[m]}" -v B_R="${B[r]}" \
            -v B_ML="${B[ml]}" -v B_H="${B[h]}" -v B_MM="${B[mm]}" -v B_MR="${B[mr]}" \
            -v B_BL="${B[bl]}" -v B_B="${B[b]}" -v B_BR="${B[br]}" -v B_BM="${B[bm]}" \
        '
        function visible_length(str) {
            gsub(/\033\[[0-9;]*[a-zA-Z]/, "", str)
            gsub(/\033\]8;;[^\033]*\033\\/, "", str)
            gsub(/\033\]8;;\033\\/, "", str)
            return length(str)
        }
        function repeat(char, n,   res) {
            res = ""
            for (k=0; k<n; k++) res = res char
            return res
        }

        BEGIN {
            num_rows = 0
            explicit_header = 0
            has_header = 0
            
            if (COLUMNS_STR != "") {
                explicit_header = 1
                has_header = 1
                split(COLUMNS_STR, header_cells, ",")
                num_cols = length(header_cells)
                for (i=1; i<=num_cols; i++) {
                    len = visible_length(header_cells[i])
                    if (len > col_widths[i]) col_widths[i] = len
                }
            }
        }

        {
            if (NR == 1 && explicit_header == 0) {
                has_header = 1
                num_cols = NF
                for (i=1; i<=NF; i++) {
                    header_cells[i] = $i
                    len = visible_length($i)
                    if (len > col_widths[i]) col_widths[i] = len
                }
                next
            }

            num_rows++
            if (NF > num_cols) num_cols = NF
            for (i=1; i<=NF; i++) {
                data[num_rows, i] = $i
                len = visible_length($i)
                if (len > col_widths[i]) col_widths[i] = len
            }
            for (i=NF+1; i<=num_cols; i++) data[num_rows, i] = ""
        }

        END {
            if (num_rows == 0 && has_header == 0) {
                if (META_FILE != "") { print "1 0 0" > META_FILE; close(META_FILE) }
                exit 0
            }

            sum_widths = 0
            for (i=1; i<=num_cols; i++) sum_widths += col_widths[i]

            total_table_width = sum_widths + (3 * num_cols) + 1
            if (BORDER_STYLE == "mdcat") total_table_width = sum_widths + (3 * num_cols) - 1

            padding_spaces = 0
            tc = TERM_COLS + 0
            if (total_table_width <= tc) {
                if (ALIGN == "center") padding_spaces = int((tc - total_table_width) / 2)
                else if (ALIGN == "right")  padding_spaces = tc - total_table_width
                if (padding_spaces < 0) padding_spaces = 0
            }
            PAD_STR = repeat(" ", padding_spaces)

            col_start = COL_OFFSET + 1
            if (col_start < 1)        col_start = 1
            if (col_start > num_cols) col_start = num_cols

            avail_inner = tc - padding_spaces
            if (BORDER_STYLE != "mdcat") avail_inner -= 2  

            running_w = 0
            col_end   = col_start - 1
            for (i = col_start; i <= num_cols; i++) {
                cost = col_widths[i] + (i == col_start ? 2 : 3)
                if (running_w + cost <= avail_inner) {
                    col_end    = i
                    running_w += cost
                } else { break }
            }
            if (col_end < col_start) col_end = col_start  
            if (META_FILE != "") {
                print col_start" "col_end" "num_cols > META_FILE
                close(META_FILE)
            }

            if (has_header) {
                if (BORDER_STYLE != "mdcat") {
                    printf "%s%s%s", PAD_STR, S_BORDER, B_TL
                    for (i=col_start; i<=col_end; i++) {
                        printf "%s", repeat(B_T, col_widths[i]+2)
                        if (i < col_end) printf "%s", B_TM
                    }
                    printf "%s%s\n", B_TR, RESET
                }

                printf "%s", PAD_STR
                if (BORDER_STYLE != "mdcat") printf "%s%s%s", S_BORDER, B_L, RESET
                
                for (i=col_start; i<=col_end; i++) {
                    val = header_cells[i]
                    diff = col_widths[i] - visible_length(val)
                    printf "%s %s%s%s%s%s%s ", S_HEAD_BG, S_HEAD_TXT, val, RESET, S_HEAD_BG, repeat(" ", diff), RESET
                    if (i < col_end) {
                        if (BORDER_STYLE == "mdcat") printf "%s%s%s", S_BORDER, B_L, RESET
                        else printf "%s%s%s", S_BORDER, B_M, RESET
                    }
                }
                if (BORDER_STYLE != "mdcat") printf "%s%s%s", S_BORDER, B_R, RESET
                print ""

                printf "%s%s", PAD_STR, S_BORDER
                
                if (BORDER_STYLE != "mdcat") printf "%s", B_ML
                
                for (i=col_start; i<=col_end; i++) {
                    printf "%s", repeat(B_H, col_widths[i]+2)
                    if (i < col_end) printf "%s", B_MM
                }
                
                if (BORDER_STYLE != "mdcat") printf "%s", B_MR
                
                printf "%s\n", RESET

            } else if (BORDER_STYLE != "mdcat") {
                 printf "%s%s%s", PAD_STR, S_BORDER, B_TL
                 for (i=col_start; i<=col_end; i++) {
                     printf "%s", repeat(B_T, col_widths[i]+2)
                     if (i < col_end) printf "%s", B_TM
                 }
                 printf "%s%s\n", B_TR, RESET
            }

            row_start = 1
            row_end = num_rows
            if (WIN_HEIGHT > 0) {
                row_start = WIN_OFFSET + 1
                row_end = WIN_OFFSET + WIN_HEIGHT
                if (row_end > num_rows) row_end = num_rows
                if (row_start > row_end) row_start = row_end + 1
            }

            for (r=row_start; r<=row_end; r++) {
                if (r > row_start && BORDER_STYLE == "rows") {
                    printf "%s%s%s", PAD_STR, S_BORDER, B_ML
                    for (i=col_start; i<=col_end; i++) {
                        printf "%s", repeat(B_H, col_widths[i]+2)
                        if (i < col_end) printf "%s", B_MM
                    }
                    printf "%s%s\n", B_MR, RESET
                }

                printf "%s", PAD_STR
                if (BORDER_STYLE != "mdcat") printf "%s%s%s", S_BORDER, B_L, RESET

                row_bg  = (SEL_ROW > 0 && r == SEL_ROW) ? S_SEL_BG  : S_CELL_BG
                row_txt = (SEL_ROW > 0 && r == SEL_ROW) ? S_SEL_TXT : S_CELL_TXT

                for (i=col_start; i<=col_end; i++) {
                    val = data[r, i]
                    diff = col_widths[i] - visible_length(val)
                    printf "%s %s%s%s%s%s%s ", row_bg, row_txt, val, RESET, row_bg, repeat(" ", diff), RESET
                    if (i < col_end) {
                        if (BORDER_STYLE == "mdcat") printf "%s%s%s", S_BORDER, B_L, RESET
                        else printf "%s%s%s", S_BORDER, B_M, RESET
                    }
                }
                if (BORDER_STYLE != "mdcat") printf "%s%s%s", S_BORDER, B_R, RESET
                print ""
            }

            if (BORDER_STYLE != "mdcat") {
                printf "%s%s%s", PAD_STR, S_BORDER, B_BL
                for (i=col_start; i<=col_end; i++) {
                    printf "%s", repeat(B_B, col_widths[i]+2)
                    if (i < col_end) printf "%s", B_BM
                }
                printf "%s%s\n", B_BR, RESET
            }
        }'
    }

    local -a all_lines=()
    mapfile -t all_lines <<< "$raw_content"

    local -i data_row_count
    if [[ -n "$columns" ]]; then
        data_row_count=${#all_lines[@]}
    else
        data_row_count=$(( ${#all_lines[@]} > 0 ? ${#all_lines[@]} - 1 : 0 ))
    fi

    local -i selected=1
    (( data_row_count == 0 )) && selected=0

    local is_interactive="false"
    [[ "$print_selection" != "true" && -t 1 && $data_row_count -gt 0 ]] && is_interactive="true"

    if [[ "$is_interactive" == "true" ]]; then
        declare -n B=B_HID
        s_border=""
    fi

    local frame
    if [[ "$is_interactive" != "true" ]]; then
        frame="$(render_frame 0 0 0 0)"
        printf '%s\n' "$frame"
        return 0
    fi

    local stty_orig=""
    stty_orig=$(stty -g < /dev/tty 2>/dev/null)
    stty -echo -icanon < /dev/tty 2>/dev/null

    local meta_file
    meta_file="$(mktemp)"

    local _interrupted=0
    local needs_redraw=true
    local -i scroll_offset=0
    local -i h_scroll_offset=0          
    local -i win_height=$height
    (( win_height > data_row_count )) && win_height=$data_row_count
    (( win_height < 1 )) && win_height=1

    local -i meta_col_start=1 meta_col_end=0 meta_num_cols=0

    trap '_interrupted=1' INT TERM
    trap 'needs_redraw=true; h_scroll_offset=0' WINCH

    function cleanup() {
        printf '%s[?25h' "$ESC" >&2
        if [[ -n "$stty_orig" ]]; then
            stty "$stty_orig" < /dev/tty 2>/dev/null
        else
            stty sane < /dev/tty 2>/dev/null
        fi
        rm -f "$meta_file" 2>/dev/null
    }

    local -i frame_lines=0

    function clear_menu() {
        if (( frame_lines > 0 )); then
            local clear_block="" k
            for (( k=0; k<frame_lines; k++ )); do clear_block+="${ESC}[K"$'\n'; done
            printf '%s%s[%dA' "$clear_block" "$ESC" "$frame_lines" >&2
        fi
    }

    function update_scroll() {
        (( selected - 1 < scroll_offset )) && scroll_offset=$(( selected - 1 ))
        (( selected - 1 >= scroll_offset + win_height )) && scroll_offset=$(( selected - win_height ))
        (( scroll_offset < 0 )) && scroll_offset=0
    }

    local footer_color=$'\e[38;2;95;95;95m'
    function render_footer() {
        local h_ind="" h_hint=""
        (( meta_col_start > 1 )) && h_ind="◀"
        (( meta_col_end > 0 && meta_col_end < meta_num_cols )) && h_ind+="▶"
        [[ -n "$h_ind" ]] && h_ind=" ${h_ind}"
        [[ -n "$h_ind" ]] && h_hint=" • ←→ cols"
        printf '%s%d/%d%s • ↓↑/jk rows%s • enter select • esc quit%s' \
            "$footer_color" "$selected" "$data_row_count" "$h_ind" "$h_hint" "$reset"
    }

    function build_frame() {
        local body
        body="$(render_frame "$selected" "$scroll_offset" "$win_height" "$h_scroll_offset" "$meta_file")"
        if [[ -s "$meta_file" ]]; then
            read -r meta_col_start meta_col_end meta_num_cols < "$meta_file"
        fi
        printf '%s\n%s' "$body" "$(render_footer)"
    }

    function draw() {
        term_cols=$(stty size 2>/dev/null </dev/tty | awk '{print $2}')
        : "${term_cols:=${COLUMNS:-$(tput cols 2>/dev/null)}}"
        : "${term_cols:=80}"
        [[ "$term_cols" =~ ^[0-9]+$ ]] || term_cols=80

        update_scroll
        frame="$(build_frame)"
        frame_lines=$(printf '%s\n' "$frame" | wc -l)

        local cleared
        cleared="$(printf '%s\n' "$frame" | sed "s/\$/${ESC}[K/")"
        printf '%s\n%s[%dA' "$cleared" "$ESC" "$frame_lines" >&2
    }

    printf '%s[?25l' "$ESC" >&2

    update_scroll
    frame="$(build_frame)"
    frame_lines=$(printf '%s\n' "$frame" | wc -l)
    local alloc="" k
    for (( k=0; k<frame_lines; k++ )); do alloc+=$'\n'; done
    printf '%s%s[%dA' "$alloc" "$ESC" "$frame_lines" >&2

    draw

    local key rest
    local confirmed="false"
    while true; do
        if (( _interrupted == 1 )); then
            clear_menu
            cleanup
            return 130
        fi

        if [[ "$needs_redraw" == "true" ]]; then
            draw
            needs_redraw=false
        fi

        key=""
        IFS= read -rsn1 -t 0.05 key < /dev/tty
        (( $? != 0 )) && continue

        if [[ "$key" == $'\x1b' ]]; then
            rest=""
            IFS= read -rsn2 -t 0.01 rest < /dev/tty
            key+="$rest"
        fi

        case "$key" in
            $'\x1b[A'|k|K) (( selected > 1 )) && (( selected-- )); needs_redraw=true ;;
            $'\x1b[B'|j|J) (( selected < data_row_count )) && (( selected++ )); needs_redraw=true ;;
            $'\x1b[C')
                if (( meta_col_end > 0 && meta_col_end < meta_num_cols )); then
                    (( h_scroll_offset++ )); needs_redraw=true
                fi
                ;;
            $'\x1b[D')
                if (( meta_col_start > 1 && h_scroll_offset > 0 )); then
                    (( h_scroll_offset-- )); needs_redraw=true
                fi
                ;;
            q|Q|$'\x1b') confirmed="false"; break ;;
            ""|$'\r'|$'\n') confirmed="true"; break ;;
            *) continue ;;
        esac
    done

    clear_menu
    cleanup
    trap - INT TERM WINCH

    if [[ "$confirmed" == "true" ]]; then
        local out_line=""
        if [[ -n "$columns" ]]; then
            out_line="${all_lines[$((selected-1))]}"
        else
            out_line="${all_lines[$selected]}"
        fi
        printf '%s\n' "$out_line"
        return 0
    fi

    return 1
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    cmd_table "${@}"
fi
