#!/usr/bin/env bash

function cmd_text() {

    local ESC=$'\e'

    local _CSS_COLORS_INIT=0
    function _css_init() {
        [[ $_CSS_COLORS_INIT -eq 1 ]] && return
        declare -gA _CSS_COLORS=(
            [aliceblue]=f0f8ff [antiquewhite]=faebd7 [aqua]=00ffff [aquamarine]=7fffd4
            [azure]=f0ffff [beige]=f5f5dc [bisque]=ffe4c4 [black]=000000
            [blanchedalmond]=ffebcd [blue]=0000ff [blueviolet]=8a2be2 [brown]=a52a2a
            [burlywood]=deb887 [cadetblue]=5f9ea0 [chartreuse]=7fff00 [chocolate]=d2691e
            [coral]=ff7f50 [cornflowerblue]=6495ed [cornsilk]=fff8dc [crimson]=dc143c
            [cyan]=00ffff [darkblue]=00008b [darkcyan]=008b8b [darkgoldenrod]=b8860b
            [darkgray]=a9a9a9 [darkgreen]=006400 [darkgrey]=a9a9a9 [darkkhaki]=bdb76b
            [darkmagenta]=8b008b [darkolivegreen]=556b2f [darkorange]=ff8c00 [darkorchid]=9932cc
            [darkred]=8b0000 [darksalmon]=e9967a [darkseagreen]=8fbc8f [darkslateblue]=483d8b
            [darkslategray]=2f4f4f [darkslategrey]=2f4f4f [darkturquoise]=00ced1 [darkviolet]=9400d3
            [deeppink]=ff1493 [deepskyblue]=00bfff [dimgray]=696969 [dimgrey]=696969
            [dodgerblue]=1e90ff [firebrick]=b22222 [floralwhite]=fffaf0 [forestgreen]=228b22
            [fuchsia]=ff00ff [gainsboro]=dcdcdc [ghostwhite]=f8f8ff [gold]=ffd700
            [goldenrod]=daa520 [gray]=808080 [green]=008000 [greenyellow]=adff2f
            [grey]=808080 [honeydew]=f0fff0 [hotpink]=ff69b4 [indianred]=cd5c5c
            [indigo]=4b0082 [ivory]=fffff0 [khaki]=f0e68c [lavender]=e6e6fa
            [lavenderblush]=fff0f5 [lawngreen]=7cfc00 [lemonchiffon]=fffacd [lightblue]=add8e6
            [lightcoral]=f08080 [lightcyan]=e0ffff [lightgoldenrodyellow]=fafad2 [lightgray]=d3d3d3
            [lightgreen]=90ee90 [lightgrey]=d3d3d3 [lightpink]=ffb6c1 [lightsalmon]=ffa07a
            [lightseagreen]=20b2aa [lightskyblue]=87cefa [lightslategray]=778899 [lightslategrey]=778899
            [lightsteelblue]=b0c4de [lightyellow]=ffffe0 [lime]=00ff00 [limegreen]=32cd32
            [linen]=faf0e6 [magenta]=ff00ff [maroon]=800000 [mediumaquamarine]=66cdaa
            [mediumblue]=0000cd [mediumorchid]=ba55d3 [mediumpurple]=9370db [mediumseagreen]=3cb371
            [mediumslateblue]=7b68ee [mediumspringgreen]=00fa9a [mediumturquoise]=48d1cc [mediumvioletred]=c71585
            [midnightblue]=191970 [mintcream]=f5fffa [mistyrose]=ffe4e1 [moccasin]=ffe4b5
            [navajowhite]=ffdead [navy]=000080 [oldlace]=fdf5e6 [olive]=808000
            [olivedrab]=6b8e23 [orange]=ffa500 [orangered]=ff4500 [orchid]=da70d6
            [palegoldenrod]=eee8aa [palegreen]=98fb98 [paleturquoise]=afeeee [palevioletred]=db7093
            [papayawhip]=ffefd5 [peachpuff]=ffdab9 [peru]=cd853f [pink]=ffc0cb
            [plum]=dda0dd [powderblue]=b0e0e6 [purple]=800080 [rebeccapurple]=663399
            [red]=ff0000 [rosybrown]=bc8f8f [royalblue]=4169e1 [saddlebrown]=8b4513
            [salmon]=fa8072 [sandybrown]=f4a460 [seagreen]=2e8b57 [seashell]=fff5ee
            [sienna]=a0522d [silver]=c0c0c0 [skyblue]=87ceeb [slateblue]=6a5acd
            [slategray]=708090 [slategrey]=708090 [snow]=fffafa [springgreen]=00ff7f
            [steelblue]=4682b4 [tan]=d2b48c [teal]=008080 [thistle]=d8bfd8
            [tomato]=ff6347 [turquoise]=40e0d0 [violet]=ee82ee [wheat]=f5deb3
            [white]=ffffff [whitesmoke]=f5f5f5 [yellow]=ffff00 [yellowgreen]=9acd32
        )
        _CSS_COLORS_INIT=1
    }

    function _list_color_names() {
        _css_init
        local names=(
            black red green yellow blue magenta purple cyan white gray grey
            brightblack brightred brightgreen brightyellow brightblue
            brightmagenta brightpurple brightcyan brightwhite
        )
        names+=("${!_CSS_COLORS[@]}")
        printf '%s\n' "${names[@]}" | sort -u | paste -sd, - | sed 's/,/, /g'
    }

    function is_valid_color() {
        local val="${1,,}"
        [[ "$val" =~ ^#([a-fA-F0-9]{6}|[a-fA-F0-9]{3})$ ]] && return 0
        [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 0 && val <= 255 )) && return 0
        case "$val" in
            black|red|green|yellow|blue|magenta|purple|cyan|white|gray|grey) return 0 ;;
            brightblack|brightred|brightgreen|brightyellow|brightblue|brightmagenta|brightpurple|brightcyan|brightwhite) return 0 ;;
        esac
        _css_init
        [[ -n "${_CSS_COLORS[$val]:-}" ]] && return 0
        return 1
    }

    function check_literal() {
        local param_name="$1"; local value="$2"; shift 2; local options=("$@")
        local found=false
        for opt in "${options[@]}"; do
            if [[ "$value" == "$opt" ]]; then found=true; break; fi
        done
        if [[ "$found" == "false" ]]; then
            local list_str=$(IFS=, ; echo "${options[*]}")
            echo "error: invalid value for --$param_name: \"$value\"" >&2
            echo "Valid options: $list_str" >&2
            return 1
        fi
        return 0
    }

    function parse_bool() {
        local val="${1,,}"
        if [[ "$val" == "true" || "$val" == "1" || "$val" == "yes" ]]; then echo "true"
        else echo "false"; fi
    }

    function die() {
        printf '%s\n' "${ESC}[31m[!] Error: $1${ESC}[0m" >&2
        exit 1
    }

    function show_help_panel() {
        cat <<EOF
Usage: bash-utils text [flags] <text>...

Includes an inline markup engine! Example:
  bash-utils text "[b]Hello[end] [fg.grad=#A,#B][dir=rtl]World[end] [fg=red]!"

Markup Tags:
  [b] [i] [u] [du]          -> bold, italic, underline, double underline
  [s] [faint] [blink]       -> strikethrough (strike), faint (dim), blink (bl)
  [rev] [h] [ol]            -> reverse (reverse), hidden (conceal), overline
  [/b] [/i] [/u] ...        -> Disable specific style (prefix with /)
  [fg=color]               -> Solid foreground (Name (incl. CSS names like 'coral'), Hex, or 0-255)
  [bg=color]               -> Solid background (Name, Hex, or 0-255)
  [fg.grad=C1,C2]          -> Foreground gradient
  [bg.grad=C1,C2]          -> Background gradient
  [dir=ltr/rtl]            -> Active foreground gradient direction
  [bg.dir=ltr/rtl]         -> Active background gradient direction
  [hypr=URL,Text]          -> Creates a clickable terminal hyperlink
  [reset] or [end]         -> Clear all styles and colors

Escapes:
  \[   -> '['
  \]   -> ']'
  \\   -> '\'

Global Flags (Serve as the base state):
  -h, --help               Show help
  --align="left"           Alignment (left, center, right)
  --foreground=""          Solid foreground color (Name, Hex or 0-255)
  --gradient="A,B"         Foreground Gradient
  --dir="ltr"              Foreground Gradient direction (ltr, rtl)
  --background=""          Solid background color
  --bg-gradient="A,B"      Background Gradient
  --bg-dir="ltr"           Background Gradient direction
  --bold                   Apply bold style
  --italic                 Apply italic style
  --underline              Apply underline style
  --double-underline       Apply double underline style (poco soportado)
  --strikethrough          Apply strikethrough style
  --faint (--dim)          Apply faint/dim style
  --reverse                Swap foreground/background colors
  --hidden (--conceal)     Hide the text (still occupies space)
  --overline               Apply an overline (soporte limitado)
  --blink                  Apply blink (muchas terminales lo ignoran)

Syntax Errors:
  Since markup tags are written inline in the text, the parser is strict
  about them (like a small language). If something looks wrong, it will
  stop and tell you exactly what's invalid and what's valid instead.
EOF
    }

    local gradient=""
    local foreground=""
    local direction="ltr"

    local bg_gradient=""
    local background=""
    local bg_direction="ltr"

    local align="left"

    local style_bold="false"
    local style_italic="false"
    local style_underline="false"
    local style_dunderline="false"
    local style_strikethrough="false"
    local style_faint="false"
    local style_reverse="false"
    local style_hidden="false"
    local style_overline="false"
    local style_blink="false"

    local args_text=()

    function _require_arg() {
        local flag="$1" remaining="$2" nextval="$3"
        if (( remaining < 2 )) || [[ "$nextval" == --* ]]; then
            die "Falta argumento para '${flag}'. Literal esperado: un valor (ni otra bandera)."
        fi
    }

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --gradient=*) val="${1#*=}"; [[ "$val" == "none" ]] && gradient="" || gradient="$val"; shift ;;
            --gradient)   _require_arg "--gradient" "$#" "$2"; [[ "$2" == "none" ]] && gradient="" || gradient="$2"; shift 2 ;;
            --foreground=*)   foreground="${1#*=}"; shift ;;
            --foreground)     _require_arg "--foreground" "$#" "$2"; foreground="$2";      shift 2 ;;
            --dir=*)          direction="${1#*=}"; shift ;;
            --dir)            _require_arg "--dir" "$#" "$2"; direction="$2";      shift 2 ;;

            --bg-gradient=*) val="${1#*=}"; [[ "$val" == "none" ]] && bg_gradient="" || bg_gradient="$val"; shift ;;
            --bg-gradient)   _require_arg "--bg-gradient" "$#" "$2"; [[ "$2" == "none" ]] && bg_gradient="" || bg_gradient="$2"; shift 2 ;;
            --background=*)   background="${1#*=}"; shift ;;
            --background)     _require_arg "--background" "$#" "$2"; background="$2";      shift 2 ;;
            --bg-dir=*)       bg_direction="${1#*=}"; shift ;;
            --bg-dir)         _require_arg "--bg-dir" "$#" "$2"; bg_direction="$2";      shift 2 ;;

            --align=*)        align="${1#*=}"; shift ;;
            --align)          _require_arg "--align" "$#" "$2"; align="$2";      shift 2 ;;

            --bold=*)          style_bold=$(parse_bool "${1#*=}"); shift ;;
            --bold)            style_bold="true"; shift ;;
            --italic=*)        style_italic=$(parse_bool "${1#*=}"); shift ;;
            --italic)          style_italic="true"; shift ;;
            --underline=*)     style_underline=$(parse_bool "${1#*=}"); shift ;;
            --underline)       style_underline="true"; shift ;;
            --double-underline=*) style_dunderline=$(parse_bool "${1#*=}"); shift ;;
            --double-underline)   style_dunderline="true"; shift ;;
            --strikethrough=*) style_strikethrough=$(parse_bool "${1#*=}"); shift ;;
            --strikethrough)   style_strikethrough="true"; shift ;;
            --faint=*)         style_faint=$(parse_bool "${1#*=}"); shift ;;
            --faint)           style_faint="true"; shift ;;
            --dim=*)           style_faint=$(parse_bool "${1#*=}"); shift ;;
            --dim)             style_faint="true"; shift ;;
            --reverse=*)       style_reverse=$(parse_bool "${1#*=}"); shift ;;
            --reverse)         style_reverse="true"; shift ;;
            --hidden=*)        style_hidden=$(parse_bool "${1#*=}"); shift ;;
            --hidden)          style_hidden="true"; shift ;;
            --conceal=*)       style_hidden=$(parse_bool "${1#*=}"); shift ;;
            --conceal)         style_hidden="true"; shift ;;
            --overline=*)      style_overline=$(parse_bool "${1#*=}"); shift ;;
            --overline)        style_overline="true"; shift ;;
            --blink=*)         style_blink=$(parse_bool "${1#*=}"); shift ;;
            --blink)           style_blink="true"; shift ;;

            -h|--help)         show_help_panel; return 0 ;;
            -*)                die "Bandera desconocida: '$1'." ;;
            *)                 args_text+=("$1"); shift ;;
        esac
    done

    check_literal "align" "$align" "left" "center" "right" || return 1
    check_literal "dir" "$direction" "ltr" "rtl" || return 1
    check_literal "bg-dir" "$bg_direction" "ltr" "rtl" || return 1

    function _die_bad_color() {
        local flag="$1" val="$2"
        die "Color invalido en '${flag}': '${val}'. Colores disponibles: $(_list_color_names)"
    }

    if [[ -n "$foreground" ]] && ! is_valid_color "$foreground"; then
        _die_bad_color "--foreground" "$foreground"
    fi
    if [[ -n "$background" ]] && ! is_valid_color "$background"; then
        _die_bad_color "--background" "$background"
    fi
    if [[ -n "$gradient" ]]; then
        local _g1="${gradient%%,*}" _g2="${gradient##*,}"
        is_valid_color "$_g1" || _die_bad_color "--gradient" "$_g1"
        is_valid_color "$_g2" || _die_bad_color "--gradient" "$_g2"
    fi
    if [[ -n "$bg_gradient" ]]; then
        local _bg1="${bg_gradient%%,*}" _bg2="${bg_gradient##*,}"
        is_valid_color "$_bg1" || _die_bad_color "--bg-gradient" "$_bg1"
        is_valid_color "$_bg2" || _die_bad_color "--bg-gradient" "$_bg2"
    fi

    local content=""
    if [[ ${#args_text[@]} -gt 0 ]]; then
        content="${args_text[*]}"
    elif [ ! -t 0 ]; then
        content=$(cat)
    fi

    [[ -z "$content" ]] && return 0

    if ! command -v awk >/dev/null 2>&1; then
        die "Este comando requiere 'awk' (mawk/gawk/nawk), y no se encontro en el PATH."
    fi

    local cur_bold=0 cur_italic=0 cur_ul=0 cur_dul=0 cur_strike=0
    local cur_faint=0 cur_rev=0 cur_hidden=0 cur_overline=0 cur_blink=0
    [[ "$style_bold" == "true" ]] && cur_bold=1
    [[ "$style_italic" == "true" ]] && cur_italic=1
    [[ "$style_underline" == "true" ]] && cur_ul=1
    [[ "$style_dunderline" == "true" ]] && cur_dul=1
    [[ "$style_strikethrough" == "true" ]] && cur_strike=1
    [[ "$style_faint" == "true" ]] && cur_faint=1
    [[ "$style_reverse" == "true" ]] && cur_rev=1
    [[ "$style_hidden" == "true" ]] && cur_hidden=1
    [[ "$style_overline" == "true" ]] && cur_overline=1
    [[ "$style_blink" == "true" ]] && cur_blink=1

    _css_init
    local css_table="" _k
    for _k in "${!_CSS_COLORS[@]}"; do
        css_table+="${_k}:${_CSS_COLORS[$_k]},"
    done

    local term_cols
    term_cols=$(tput cols 2>/dev/null || echo 80)

    AWKTXT_CSS="$css_table" \
    AWKTXT_ALIGN="$align" \
    AWKTXT_COLS="$term_cols" \
    AWKTXT_BOLD="$cur_bold" AWKTXT_ITALIC="$cur_italic" AWKTXT_UNDERLINE="$cur_ul" \
    AWKTXT_DUNDERLINE="$cur_dul" AWKTXT_STRIKE="$cur_strike" AWKTXT_FAINT="$cur_faint" \
    AWKTXT_REVERSE="$cur_rev" AWKTXT_HIDDEN="$cur_hidden" AWKTXT_OVERLINE="$cur_overline" \
    AWKTXT_BLINK="$cur_blink" \
    AWKTXT_FG="$foreground" AWKTXT_FG_GRAD="$gradient" AWKTXT_FG_DIR="$direction" \
    AWKTXT_BG="$background" AWKTXT_BG_GRAD="$bg_gradient" AWKTXT_BG_DIR="$bg_direction" \
    awk "$_TEXT_AWK_ENGINE" "$content" || return $?
}

read -r -d '' _TEXT_AWK_ENGINE << 'AWK_EOF'
function hex2dec(h,   i, c, v, p) {
    v = 0
    for (i = 1; i <= length(h); i++) {
        c = tolower(substr(h, i, 1))
        p = index("0123456789abcdef", c) - 1
        v = v * 16 + p
    }
    return v
}

function setup_basic_names() {
    basic_names["black"]=0; basic_names["red"]=1; basic_names["green"]=2; basic_names["yellow"]=3
    basic_names["blue"]=4; basic_names["magenta"]=5; basic_names["purple"]=5
    basic_names["cyan"]=6; basic_names["white"]=7
    basic_names["brightblack"]=8; basic_names["gray"]=8; basic_names["grey"]=8
    basic_names["brightred"]=9; basic_names["brightgreen"]=10; basic_names["brightyellow"]=11
    basic_names["brightblue"]=12; basic_names["brightmagenta"]=13; basic_names["brightpurple"]=13
    basic_names["brightcyan"]=14; basic_names["brightwhite"]=15
}

function css_init(   parts, kv, i, n) {
    n = split(ENVIRON["AWKTXT_CSS"], parts, ",")
    for (i = 1; i <= n; i++) {
        if (parts[i] == "") continue
        split(parts[i], kv, ":")
        if (kv[1] != "") css[kv[1]] = kv[2]
    }
}

function is_hex(v) {
    return (v ~ /^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/) \
        || (v ~ /^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)
}

function expand_hex(v,   h) {
    h = substr(v, 2)
    if (length(h) == 3)
        h = substr(h,1,1) substr(h,1,1) substr(h,2,1) substr(h,2,1) substr(h,3,1) substr(h,3,1)
    return "#" h
}

function is_valid_color(v,   lv) {
    lv = tolower(v)
    if (is_hex(lv)) return 1
    if (lv ~ /^[0-9]+$/ && (lv+0) >= 0 && (lv+0) <= 255) return 1
    if (lv in basic_names) return 1
    if (lv in css) return 1
    return 0
}

function resolve_color(v,   lv) {
    lv = tolower(v)
    if (lv ~ /^#/) return expand_hex(lv)
    if (lv in basic_names) return basic_names[lv]
    if (lv in css) return "#" css[lv]
    return lv
}

function get_rgb(v,   lv, hex, h, r, g, b, c, n, vals, i1, i2, i3, gray, std) {
    lv = tolower(v)
    if (lv in basic_names) { c = basic_names[lv]+0 }
    else if (lv ~ /^#/) {
        hex = expand_hex(lv); h = substr(hex,2)
        r = hex2dec(substr(h,1,2)); g = hex2dec(substr(h,3,2)); b = hex2dec(substr(h,5,2))
        return r" "g" "b
    }
    else if (lv ~ /^[0-9]+$/) { c = lv+0 }
    else if (lv in css) {
        h = css[lv]
        r = hex2dec(substr(h,1,2)); g = hex2dec(substr(h,3,2)); b = hex2dec(substr(h,5,2))
        return r" "g" "b
    }
    else return "255 255 255"

    if (c >= 16 && c <= 231) {
        split("0 95 135 175 215 255", vals, " ")
        n = c - 16
        i1 = int(n/36)+1; i2 = int((n%36)/6)+1; i3 = (n%6)+1
        return vals[i1]" "vals[i2]" "vals[i3]
    } else if (c >= 232 && c <= 255) {
        gray = (c-232)*10+8
        return gray" "gray" "gray
    } else {
        split("0 0 0,205 0 0,0 205 0,205 205 0,0 0 238,205 0 205,0 205 205,229 229 229,127 127 127,255 0 0,0 255 0,255 255 0,92 92 255,255 0 255,0 255 255,255 255 255", std, ",")
        if (c > 15) c = 15
        return std[c+1]
    }
}

function register_gradient(id, c1, c2, dir,   rgb) {
    split(get_rgb(c1), rgb, " "); gr1[id]=rgb[1]; gg1[id]=rgb[2]; gb1[id]=rgb[3]
    split(get_rgb(c2), rgb, " "); gr2[id]=rgb[1]; gg2[id]=rgb[2]; gb2[id]=rgb[3]
    gdir[id] = dir
}

function color_code(val, layer,   rv, hex, r, g, b) {
    rv = resolve_color(val)
    if (rv ~ /^#/) {
        hex = substr(rv, 2)
        r = hex2dec(substr(hex,1,2)); g = hex2dec(substr(hex,3,2)); b = hex2dec(substr(hex,5,2))
        return layer";2;"r";"g";"b
    }
    return layer";5;"rv
}

function list_color_names(   arr, keys, k, i, j, tmp, cnt, out) {
    delete arr
    for (k in basic_names) arr[k]=1
    for (k in css) arr[k]=1
    cnt = 0
    for (k in arr) { cnt++; keys[cnt]=k }
    for (i=1; i<=cnt; i++)
        for (j=i+1; j<=cnt; j++)
            if (keys[j] < keys[i]) { tmp=keys[i]; keys[i]=keys[j]; keys[j]=tmp }
    out = ""
    for (i=1; i<=cnt; i++) out = out (out=="" ? "" : ", ") keys[i]
    return out
}

function err_color(key, val) {
    print "Error de sintaxis: color invalido en [" key "]: \"" val "\"" > "/dev/stderr"
    print "  Colores disponibles: black, red, green, yellow, blue, magenta (purple)," > "/dev/stderr"
    print "                       cyan, white, gray (grey), brightblack, brightred," > "/dev/stderr"
    print "                       brightgreen, brightyellow, brightblue, brightmagenta," > "/dev/stderr"
    print "                       brightcyan, brightwhite" > "/dev/stderr"
    print "  Tambien valido: hex (#RRGGBB o #RGB), codigo 0-255, o nombres CSS (coral," > "/dev/stderr"
    print "                  mediumseagreen, rebeccapurple, etc)." > "/dev/stderr"
    print "  Lista completa de nombres CSS: " list_color_names() > "/dev/stderr"
}

function err_direction(key, val) {
    print "Error de sintaxis: valor invalido en [" key "]: \"" val "\"" > "/dev/stderr"
    print "  Valores disponibles: ltr, rtl" > "/dev/stderr"
}

function err_gradient_format(key) {
    print "Error de sintaxis: [" key "] espera dos colores separados por coma -> color1,color2" > "/dev/stderr"
}

function err_unknown_tag(key, full,   k2) {
    if (index(key, "fg.") == 1 && key != "fg.grad") {
        k2 = substr(key, 4)
        print "Error de sintaxis: 'fg' no tiene el atributo '" k2 "'." > "/dev/stderr"
        print "  Atributos disponibles para 'fg': grad" > "/dev/stderr"
        return
    }
    if (index(key, "foreground.") == 1 && key != "foreground.gradient") {
        k2 = substr(key, 12)
        print "Error de sintaxis: 'foreground' no tiene el atributo '" k2 "'." > "/dev/stderr"
        print "  Atributos disponibles para 'foreground': gradient" > "/dev/stderr"
        return
    }
    if (index(key, "bg.") == 1 && key != "bg.grad" && key != "bg.dir") {
        k2 = substr(key, 4)
        print "Error de sintaxis: 'bg' no tiene el atributo '" k2 "'." > "/dev/stderr"
        print "  Atributos disponibles para 'bg': grad, dir" > "/dev/stderr"
        return
    }
    if (index(key, "background.") == 1 && key != "background.gradient" && key != "background.direction") {
        k2 = substr(key, 12)
        print "Error de sintaxis: 'background' no tiene el atributo '" k2 "'." > "/dev/stderr"
        print "  Atributos disponibles para 'background': gradient, direction" > "/dev/stderr"
        return
    }
    print "Error de sintaxis: tag desconocido -> \"[" full "]\"" > "/dev/stderr"
    print "  Tags disponibles: bold(b), italic(i), underline(u), dunderline(du)," > "/dev/stderr"
    print "                    strikethrough(strike/s), faint(dim), reverse(rev)," > "/dev/stderr"
    print "                    hidden(conceal/h), overline(ol), blink(bl), reset(end)," > "/dev/stderr"
    print "                    fg(foreground), bg(background), fg.grad(foreground.gradient)," > "/dev/stderr"
    print "                    bg.grad(background.gradient), dir(direction), bg.dir(background.direction)," > "/dev/stderr"
    print "                    hypr(hyperlink)" > "/dev/stderr"
    print "  Tip: si querias imprimir un corchete literal, escapalo: \\[ y \\]" > "/dev/stderr"
}

function push_char(ch,   f, b) {
    n++
    chc[n] = ch
    st_bold[n]=bold; st_italic[n]=italic; st_ul[n]=ul; st_dul[n]=dul; st_strike[n]=strike
    st_faint[n]=faint; st_rev[n]=rev; st_hidden[n]=hidden; st_overline[n]=overline; st_blink[n]=blink

    if (fg_grad != "") { f = "grad:" fg_grad_id; grad_count[fg_grad_id]++ }
    else if (fg != "") { f = "solid:" fg }
    else { f = "" }
    st_fg[n] = f

    if (bg_grad != "") { b = "grad:" bg_grad_id; grad_count[bg_grad_id]++ }
    else if (bg != "") { b = "solid:" bg }
    else { b = "" }
    st_bg[n] = b

    st_hypr[n] = hypr_active ? hypr_url : "NONE"
}

function process_tag(tag, key, val,   c1, c2, u, htext, hl, hi, comma, backup_fg) {
    if (tag=="bold"||tag=="b") { bold=1; return 0 }
    if (tag=="/bold"||tag=="/b") { bold=0; return 0 }
    if (tag=="italic"||tag=="i") { italic=1; return 0 }
    if (tag=="/italic"||tag=="/i") { italic=0; return 0 }
    if (tag=="underline"||tag=="u") { ul=1; return 0 }
    if (tag=="/underline"||tag=="/u") { ul=0; return 0 }
    if (tag=="dunderline"||tag=="du") { dul=1; return 0 }
    if (tag=="/dunderline"||tag=="/du") { dul=0; return 0 }
    if (tag=="strikethrough"||tag=="strike"||tag=="s") { strike=1; return 0 }
    if (tag=="/strikethrough"||tag=="/strike"||tag=="/s") { strike=0; return 0 }
    if (tag=="faint"||tag=="dim") { faint=1; return 0 }
    if (tag=="/faint"||tag=="/dim") { faint=0; return 0 }
    if (tag=="reverse"||tag=="rev") { rev=1; return 0 }
    if (tag=="/reverse"||tag=="/rev") { rev=0; return 0 }
    if (tag=="hidden"||tag=="conceal"||tag=="h") { hidden=1; return 0 }
    if (tag=="/hidden"||tag=="/conceal"||tag=="/h") { hidden=0; return 0 }
    if (tag=="overline"||tag=="ol") { overline=1; return 0 }
    if (tag=="/overline"||tag=="/ol") { overline=0; return 0 }
    if (tag=="blink"||tag=="bl") { blink=1; return 0 }
    if (tag=="/blink"||tag=="/bl") { blink=0; return 0 }
    if (tag=="reset"||tag=="end") {
        bold=0;italic=0;ul=0;dul=0;strike=0;faint=0;rev=0;hidden=0;overline=0;blink=0
        fg="";fg_grad="";fg_dir="ltr"
        bg="";bg_grad="";bg_dir="ltr"
        return 0
    }
    if (key=="fg" || key=="foreground") {
        if (!is_valid_color(val)) { err_color(key, val); return -1 }
        fg = val; fg_grad = ""
        return 0
    }
    if (key=="bg" || key=="background") {
        if (!is_valid_color(val)) { err_color(key, val); return -1 }
        bg = val; bg_grad = ""
        return 0
    }
    if (key=="fg.grad" || key=="foreground.gradient") {
        if (index(val, ",")==0) { err_gradient_format(key); return -1 }
        split(val, gp, ","); c1=gp[1]; c2=gp[2]
        if (!is_valid_color(c1)) { err_color(key,c1); return -1 }
        if (!is_valid_color(c2)) { err_color(key,c2); return -1 }
        fg_grad = val; fg = ""
        grad_n++; register_gradient(grad_n, c1, c2, fg_dir); fg_grad_id = grad_n
        return 0
    }
    if (key=="bg.grad" || key=="background.gradient") {
        if (index(val, ",")==0) { err_gradient_format(key); return -1 }
        split(val, gp, ","); c1=gp[1]; c2=gp[2]
        if (!is_valid_color(c1)) { err_color(key,c1); return -1 }
        if (!is_valid_color(c2)) { err_color(key,c2); return -1 }
        bg_grad = val; bg = ""
        grad_n++; register_gradient(grad_n, c1, c2, bg_dir); bg_grad_id = grad_n
        return 0
    }
    if (key=="dir" || key=="direction") {
        if (val!="ltr" && val!="rtl") { err_direction(key,val); return -1 }
        fg_dir = val
        if (fg_grad!="") gdir[fg_grad_id]=fg_dir
        return 0
    }
    if (key=="bg.dir" || key=="background.direction") {
        if (val!="ltr" && val!="rtl") { err_direction(key,val); return -1 }
        bg_dir = val
        if (bg_grad!="") gdir[bg_grad_id]=bg_dir
        return 0
    }
    if (key=="hypr") {
        comma = index(val, ",")
        if (comma==0) {
            print "Error de sintaxis: [hypr] espera URL y Texto separados por coma -> [hypr=https://google.com,Enlace]" > "/dev/stderr"
            return -1
        }
        u = substr(val,1,comma-1)
        htext = substr(val, comma+1)
        backup_fg = fg
        if (fg=="" && fg_grad=="") fg = "blue"
        hypr_active = 1; hypr_url = u
        hl = length(htext)
        for (hi=1; hi<=hl; hi++) push_char(substr(htext,hi,1))
        hypr_active = 0
        fg = backup_fg
        return 0
    }
    err_unknown_tag(key, tag)
    return -1
}

function grad_step_rgb(gid,   total, step, div, r1,g1,b1,r2,g2,b2, r,g,b) {
    total = grad_count[gid]; if (total<1) total=1
    step = grad_pos[gid]+0
    grad_pos[gid] = step + 1
    div = total-1; if (div<1) div=1
    if (gdir[gid]=="rtl") { r1=gr2[gid];g1=gg2[gid];b1=gb2[gid];r2=gr1[gid];g2=gg1[gid];b2=gb1[gid] }
    else { r1=gr1[gid];g1=gg1[gid];b1=gb1[gid];r2=gr2[gid];g2=gg2[gid];b2=gb2[gid] }
    r=int(r1+(r2-r1)*step/div); g=int(g1+(g2-g1)*step/div); b=int(b1+(b2-b1)*step/div)
    return r";"g";"b
}

function render(   pad, i, ch, sgr, codes, key, is_grad, cur_hypr, prevkey, gid, rgb, out) {
    pad = 0
    if (align=="center") pad = int((cols - n)/2)
    else if (align=="right") pad = cols - n
    if (pad < 0) pad = 0

    out = sprintf("%" pad "s", "")
    cur_hypr = "NONE"
    prevkey = ""

    for (i=1; i<=n; i++) {
        ch = chc[i]
        is_grad = (index(st_fg[i], "grad:")==1) || (index(st_bg[i], "grad:")==1)
        key = st_bold[i]"|"st_italic[i]"|"st_ul[i]"|"st_dul[i]"|"st_strike[i]"|"st_faint[i]"|"st_rev[i]"|"st_hidden[i]"|"st_overline[i]"|"st_blink[i]"|"st_fg[i]"|"st_bg[i]"|"st_hypr[i]

        if (!is_grad && key == prevkey) { out = out ch; continue }

        sgr = ESC "[0m"

        if (st_hypr[i] != cur_hypr) {
            if (st_hypr[i] == "NONE") sgr = sgr ESC "]8;;" ESC "\\"
            else sgr = sgr ESC "]8;;" st_hypr[i] ESC "\\"
            cur_hypr = st_hypr[i]
        }

        codes = ""
        if (st_bold[i]) codes = codes "1;"
        if (st_faint[i]) codes = codes "2;"
        if (st_italic[i]) codes = codes "3;"
        if (st_dul[i]) codes = codes "21;"
        else if (st_ul[i]) codes = codes "4;"
        if (st_blink[i]) codes = codes "5;"
        if (st_rev[i]) codes = codes "7;"
        if (st_hidden[i]) codes = codes "8;"
        if (st_strike[i]) codes = codes "9;"
        if (st_overline[i]) codes = codes "53;"
        if (codes != "") sgr = sgr ESC "[" substr(codes,1,length(codes)-1) "m"

        if (index(st_fg[i], "solid:")==1) {
            sgr = sgr ESC "[" color_code(substr(st_fg[i],7), 38) "m"
        } else if (index(st_fg[i], "grad:")==1) {
            gid = substr(st_fg[i], 6)
            rgb = grad_step_rgb(gid)
            sgr = sgr ESC "[38;2;" rgb "m"
        }

        if (index(st_bg[i], "solid:")==1) {
            sgr = sgr ESC "[" color_code(substr(st_bg[i],7), 48) "m"
        } else if (index(st_bg[i], "grad:")==1) {
            gid = substr(st_bg[i], 6)
            rgb = grad_step_rgb(gid)
            sgr = sgr ESC "[48;2;" rgb "m"
        }

        out = out sgr ch
        prevkey = key
    }

    if (cur_hypr != "NONE") out = out ESC "]8;;" ESC "\\"
    out = out ESC "[0m"
    printf "%s\n", out
}

function strip_ansi(s) {
    gsub(/\033\[[0-9;?]*[a-zA-Z]/, "", s)
    gsub(/\033\][0-9]+;[^\007\033]*\007/, "", s)
    gsub(/\033[()%#][0-9A-Za-z]/, "", s)
    gsub(/\033[A-Za-z<=>78]/, "", s)
    gsub(/\007/, "", s)
    return s
}

BEGIN {
    content = ARGV[1]
    ESC = sprintf("%c", 27)
    content = strip_ansi(content)

    setup_basic_names()
    css_init()

    bold = ENVIRON["AWKTXT_BOLD"]+0
    italic = ENVIRON["AWKTXT_ITALIC"]+0
    ul = ENVIRON["AWKTXT_UNDERLINE"]+0
    dul = ENVIRON["AWKTXT_DUNDERLINE"]+0
    strike = ENVIRON["AWKTXT_STRIKE"]+0
    faint = ENVIRON["AWKTXT_FAINT"]+0
    rev = ENVIRON["AWKTXT_REVERSE"]+0
    hidden = ENVIRON["AWKTXT_HIDDEN"]+0
    overline = ENVIRON["AWKTXT_OVERLINE"]+0
    blink = ENVIRON["AWKTXT_BLINK"]+0

    fg = ENVIRON["AWKTXT_FG"]
    fg_grad = ENVIRON["AWKTXT_FG_GRAD"]
    fg_dir = ENVIRON["AWKTXT_FG_DIR"]; if (fg_dir=="") fg_dir="ltr"
    bg = ENVIRON["AWKTXT_BG"]
    bg_grad = ENVIRON["AWKTXT_BG_GRAD"]
    bg_dir = ENVIRON["AWKTXT_BG_DIR"]; if (bg_dir=="") bg_dir="ltr"

    align = ENVIRON["AWKTXT_ALIGN"]
    cols = ENVIRON["AWKTXT_COLS"]+0

    grad_n = 0; fg_grad_id = 0; bg_grad_id = 0
    if (fg_grad != "") {
        split(fg_grad, gp, ",")
        if (!is_valid_color(gp[1])) { err_color("gradient", gp[1]); exit 1 }
        if (!is_valid_color(gp[2])) { err_color("gradient", gp[2]); exit 1 }
        grad_n++; register_gradient(grad_n, gp[1], gp[2], fg_dir); fg_grad_id = grad_n
    }
    if (bg_grad != "") {
        split(bg_grad, gp, ",")
        if (!is_valid_color(gp[1])) { err_color("bg-gradient", gp[1]); exit 1 }
        if (!is_valid_color(gp[2])) { err_color("bg-gradient", gp[2]); exit 1 }
        grad_n++; register_gradient(grad_n, gp[1], gp[2], bg_dir); bg_grad_id = grad_n
    }

    n = 0
    hypr_active = 0
    hypr_url = ""

    len = length(content)
    i = 1
    exit_code = 0
    while (i <= len) {
        c = substr(content, i, 1)

        if (c == "\\" && i < len) {
            nc = substr(content, i+1, 1)
            if (nc == "[" || nc == "]" || nc == "\\") {
                push_char(nc)
                i += 2
                continue
            }
        }

        if (c == "[") {
            rest = substr(content, i)
            close_pos = index(rest, "]")
            if (close_pos == 0) {
                print "Error de sintaxis: tag sin cerrar -> '" rest "'" > "/dev/stderr"
                print "  Falta el ']' que lo cierre." > "/dev/stderr"
                exit_code = 1
                break
            }
            tag = substr(rest, 2, close_pos-2)

            eq_pos = index(tag, "=")
            if (eq_pos > 0) { key = substr(tag,1,eq_pos-1); val = substr(tag,eq_pos+1) }
            else { key = tag; val = "" }

            if (process_tag(tag, key, val) == -1) { exit_code = 1; break }

            i += close_pos
            continue
        }

        if (c == "]") {
            print "Error de sintaxis: se encontro ']' sin un '[' que lo haya abierto -> ']'" > "/dev/stderr"
            exit_code = 1
            break
        }

        push_char(c)
        i++
    }

    if (exit_code == 0) render()
    exit exit_code
}
AWK_EOF

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    cmd_text "${@}"
fi
