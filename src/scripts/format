#!/usr/bin/env bash 

function cmd_format(){
    # Emojis -> https://raw.githubusercontent.com/kyokomi/emoji/master/emoji_codemap.go 
    local _SCRIPT_DIR
    _SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local _EMOJIS_TSV="${_SCRIPT_DIR}/../icons/emojis.tsv"

    function _show_usage(){
        cat <<EOF
Usage: bash-ut format [<template> ...] [flags]

Format a string using a template

Arguments:
  [<template> ...]    Template string to format (can also be provided via stdin)

Flags:
  -h, --help               Show context-sensitive help.
  -t, --type="markdown"    Format to use (markdown | emoji)
EOF
    }

    local type="markdown"
    local -a positional=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                _show_usage
                return 0
                ;;
            --type=*)
                type="${1#--type=}"
                type="${type//\"/}"
                ;;
            -t|--type)
                shift
                type="$1"
                ;;
            --)
                shift
                positional+=("$@")
                break
                ;;
            -*)
                printf 'error: unknown flag: %s\n' "$1" >&2
                return 1
                ;;
            *)
                positional+=("$1")
                ;;
        esac
        shift
    done

    case "$type" in
        markdown|emoji) ;;
        *)
            printf 'error: --type must be "markdown" or "emoji"\n' >&2
            return 1
            ;;
    esac

    local text
    if [[ ${#positional[@]} -gt 0 ]]; then
        text="${positional[*]}"
    elif [[ ! -t 0 ]]; then
        text="$(cat)"
    else
        _show_usage
        return 0
    fi

    function _format_emoji(){
        local esc_input="${1//\\/\\\\}"

        awk -v input="$esc_input" -F'\t' '
            BEGIN {
                placeholder = "\001"          # carácter que nunca aparece en texto normal
                gsub(/\\:/, placeholder, input)  # proteger los ":" escapados
            }
            NF >= 2 && $1 != "" && $2 != "" {
                gsub($1, $2, input)
            }
            END {
                gsub(placeholder, ":", input)  # restaurar como ":" literal, sin la barra
                print input
            }
        ' "$_EMOJIS_TSV"
    }


    function _format_markdown(){

      _mdcat_strip=$(mktemp /tmp/_mdcat_strip_XXXXXX)
      cat > "$_mdcat_strip" << 'STRIPEOF'
      #!/usr/bin/env bash

      strip_ansi() {
          local input
          if [[ $# -gt 0 ]]; then
              input="$*"
          else
              IFS= read -r -d '' input
          fi

          local out=""
          local -i state=0 
          local -r ESC=$'\x1b'
          local -r BEL=$'\x07'
          local -i i len=${#input}
          local c

          for (( i=0; i<len; i++ )); do
              c="${input:i:1}"
              case "$state" in
                  0) 
                      case "$c" in
                          "$ESC") state=1 ;;
                          "$BEL") : ;;
                          *) out+="$c" ;;
                      esac
                      ;;
                  1) 
                      case "$c" in
                          '[') state=2 ;;
                          ']') state=3 ;;
                          '%'|'('|')'|'0'|'3'|'5'|'6'|'#') state=5 ;;
                          "$BEL"|'A'|'B'|'C'|'D'|'E'|'H'|'I'|'J'|'K'|'M'|'N'|'O'|'S'|'T'|'Z'|'c'|'s'|'u'|'1'|'2'|'7'|'8'|'<'|'='|'>')
                              state=0 ;;
                          *)
                              out+="${ESC}${c}"
                              state=0
                              ;;
                      esac
                      ;;
                  2) 
                      case "$c" in
                          ';'|'?'|[0-9]) : ;;
                          *) state=0 ;;
                      esac
                      ;;
                  3) 
                      case "$c" in
                          [0-9]) state=4 ;;
                          *) state=0 ;;
                      esac
                      ;;
                  4) 
                      case "$c" in
                          "$BEL") state=0 ;;
                          "$ESC") state=5 ;;
                      esac
                      ;;
                  5)
                      state=0
                      ;;
              esac
          done

          printf '%s' "$out"
      }

      strip_ansi < "$1"
STRIPEOF
      chmod +x "$_mdcat_strip"
