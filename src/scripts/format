      function get_depth(line,    d, rest) {
          d = 0; rest = line
          while (match(rest, /^> */)) {
              d++
              rest = substr(rest, RLENGTH + 1)
              if (substr(rest, 1, 1) != ">") break
          }
          return d
      }

      function esc_encode(text,    i, c, n, out) {
          out = ""
          for (i = 1; i <= length(text); i++) {
              c = substr(text, i, 1)
              if (c == "\\" && i < length(text)) {
                  n = substr(text, i+1, 1)
                  if (n in _ec_enc) { out = out _ec_enc[n]; i++; continue }
              }
              out = out c
          }
          return out
      }

      function color_to_ansi(val, prefix,    m, h) {
          gsub(/[[:space:]]/, "", val)
          val = tolower(val)

          if (val in css_color) {
              if (val in css_pal) {
                  return sprintf("\033[%s;5;%dm", prefix, css_pal[val])
              }
              h = css_color[val]
              return sprintf("\033[%s;2;%d;%d;%dm", prefix,
                  strtonum("0x" substr(h,1,2)),
                  strtonum("0x" substr(h,3,2)),
                  strtonum("0x" substr(h,5,2)))
          }


          if (val ~ /^#[0-9a-f]{3}$/) {                      # #rgb
              h = substr(val, 2)
              return sprintf("\033[%s;2;%d;%d;%dm", prefix,
                  strtonum("0x" substr(h,1,1) substr(h,1,1)),
                  strtonum("0x" substr(h,2,1) substr(h,2,1)),
                  strtonum("0x" substr(h,3,1) substr(h,3,1)))
          }
          if (val ~ /^#[0-9a-f]{6}$/) {                      # #rrggbb
              h = substr(val, 2)
              return sprintf("\033[%s;2;%d;%d;%dm", prefix,
                  strtonum("0x" substr(h,1,2)),
                  strtonum("0x" substr(h,3,2)),
                  strtonum("0x" substr(h,5,2)))
          }
          if (match(val, /^rgba?\(([0-9]{1,3}),([0-9]{1,3}),([0-9]{1,3})(,[0-9.]+)?\)$/, m)) {
              if (m[1]+0 > 255 || m[2]+0 > 255 || m[3]+0 > 255) return ""
              return sprintf("\033[%s;2;%d;%d;%dm", prefix, m[1]+0, m[2]+0, m[3]+0)
              # alpha (m[4]) ignorado — terminales no lo soportan
          }
          return ""   
      }

      function render_span_tags(str, restore_fg,    out, rest, m, style, fg, bg, val, inner) {
          out = ""; rest = str
          while (match(rest, /<span[[:space:]]+style="([^"]*)"[[:space:]]*>/, m)) {
              out   = out substr(rest, 1, RSTART - 1)
              style = m[1]
              rest  = substr(rest, RSTART + RLENGTH)

              if (!match(rest, /^([^<]*)<\/span>/, m)) {
                  out = out "<span style=\"" style "\">"
                  continue
              }
              inner = m[1]
              rest  = substr(rest, RLENGTH + 1)

              fg = ""; bg = ""

              # color: <valor>
              if (match(style, /(^|;)[[:space:]]*color[[:space:]]*:[[:space:]]*([^;]+)/, m)) {
                  val = m[2]; gsub(/[[:space:]]*$/, "", val)
                  fg = color_to_ansi(val, "38")
              }
              # background-color: o background: <valor>
              if (match(style, /(^|;)[[:space:]]*(background-color|background)[[:space:]]*:[[:space:]]*([^;]+)/, m)) {
                  val = m[3]; gsub(/[[:space:]]*$/, "", val)
                  bg = color_to_ansi(val, "48")
              }

              if (fg == "" && bg == "") {
                  out = out "<span style=\"" style "\">" inner "</span>"
              } else {
                  out = out fg bg inner reset restore_fg
              }
          }
          return out rest
      }

      function esc_decode(text,    i, c, n, out) {
          out = ""
          for (i = 1; i <= length(text); i++) {
              c = substr(text, i, 1)
              if (c == "\x01" && i < length(text)) {
                  n = substr(text, i+1, 1)
                  if (n in _ec_dec) { out = out _ec_dec[n]; i++; continue }
              }
              out = out c
          }
          return out
      }
       
      function make_prefix(depth,    i, p, c) {
          p = ""
          for (i = 1; i < depth; i++) {
              c = (color_stack[i] != "") ? color_stack[i] : gray
              p = p c BAR_PREFIX
          }
          return p
      }

      function visible_prefix_len(prefix, depth) {
          # cada nivel aporta "▌  " = 3 chars visibles
          return (depth - 1) * 3 + 3 
      }

      function visible_len(s,    tmp, i, n, ch, w) {
          tmp = s
          gsub(/\033\[[0-9;?]*[a-zA-Z]/, "", tmp)      
          gsub(/\033\][^\007]*\007/, "", tmp)           
          gsub(/\033\][^\033]*\033\\/, "", tmp)         
          gsub(/\033/, "", tmp)                         

          w = 0
          n = length(tmp)
          for (i = 1; i <= n; i++) {
              ch = substr(tmp, i, 1)
              if (ch == "️") continue
              else if (ch ~ EMOJI_RANGE) w += 2
              else w += 1
          }
          return w
      }
      function print_wrapped(prefix, cur_fg, restore_fg, text, bullet,    term_w, max_w, formatted, wrapped, nw, i, line_out) {
          term_w = 0
          "stty size < /dev/tty 2>/dev/null" | getline _stty_out
          close("stty size < /dev/tty 2>/dev/null")
          split(_stty_out, _stty_parts, " ")
          term_w = _stty_parts[2] + 0
          if (term_w <= 0) term_w = 80

          overhead = (depth * 3)
          if (bullet != "") overhead += 2
          max_w = term_w - overhead
          if (max_w < 20) max_w = 20

          formatted = format_inline(text, restore_fg)

          delete wrapped
          nw = wrap_cell(formatted, max_w, wrapped, 1)

          if (nw == 0) {
              print prefix cur_fg BAR_PREFIX restore_fg reset
              return
          }

          for (i = 0; i < nw; i++) {
              line_out = wrapped[1, i]
              if (i == 0 && bullet != "")
                  print prefix cur_fg BAR_PREFIX restore_fg bullet " " line_out reset
              else
                  print prefix cur_fg BAR_PREFIX restore_fg line_out reset
          }
      }
      function convert_br(str,    out) {
          out = str
          gsub(/<br[ \t]*\/?>/, "\n", out)
          gsub(/<\/br[ \t]*>/, "\n", out)   
          return out
      }


      function dims_text(w, h) {
          if (w != "" && h != "") return w "x" h
          if (w != "")            return w " de ancho"
          if (h != "")            return h " de alto"
          return ""
      }

      function is_zero_size_img(w, h) {
          if (w != "" && w ~ /^0(px)?$/) return 1
          if (h != "" && h ~ /^0(px)?$/) return 1
          return 0
      }

      function render_img_inline(str,    result, rest, arr, a2, tag, alt, src, w, h, dims, dt, m_start, m_len) {
          result = ""
          rest = str
          while (match(rest, /<img[^>]*>/, arr)) {
              m_start = RSTART   # guardar ANTES de los match() anidados de abajo
              m_len   = RLENGTH
              tag = arr[0]
              alt = ""; src = ""; w = ""; h = ""
              if (match(tag, /alt="([^"]*)"/, a2))       alt = a2[1]
              if (match(tag, /src="([^"]*)"/, a2))       src = a2[1]
              if (match(tag, /width="?([0-9]+)(px)?"?/, a2))  w = a2[1]
              if (match(tag, /height="?([0-9]+)(px)?"?/, a2)) h = a2[1]

              if (is_zero_size_img(w, h)) {
                  result = result substr(rest, 1, m_start - 1)
                  rest = substr(rest, m_start + m_len)
                  continue
              }

              result = result substr(rest, 1, m_start - 1)
              if (alt == "") alt = "imagen"
              dt = dims_text(w, h)
              dims = (dt != "") ? (" " gray "(" dt ")" reset) : ""
              if (src != "")
                  result = result gray image_icon_for(src) reset osc8_pre src osc8_st c_link alt reset osc8_close dims
              else
                  result = result gray "🖼 " reset alt dims
              rest = substr(rest, m_start + m_len)
          }
          result = result rest
          return result
      }

      function render_autolinks(str,    result, rest, arr) {
          result = ""
          rest = str
          while (match(rest, /<(https?:\/\/[^ <>]+)>/, arr)) {
              result = result substr(rest, 1, RSTART - 1)
              result = result c_link osc8_pre arr[1] osc8_st link_icon_for(arr[1]) arr[1] reset osc8_close
              rest = substr(rest, RSTART + RLENGTH)
          }
          while (match(rest, /<([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,})>/, arr)) {
              result = result substr(rest, 1, RSTART - 1)
              result = result c_link "󰇮 " arr[1] reset
              rest = substr(rest, RSTART + RLENGTH)
          }
          result = result rest
          return result
      }

      function render_style_tags(str, restore_fg,    result, rest, arr, tagraw, closing, tagname, canon, depth, stack, i, j, seg, onseq, sawtag, valid, found) {

          valid = 1
          depth = 0
          rest = str
          while (match(rest, /<\/?(b|bold|strong|i|italic|em|code|u|ins|s|strike|del|mark)>/, arr)) {
              tagraw  = tolower(arr[0])
              closing = (tagraw ~ /^<\//)
              tagname = tagraw
              gsub(/[<>\/]/, "", tagname)
              canon = style_tag_canon[tagname]
              if (closing) {
                  found = 0
                  for (i = depth; i >= 1; i--) {
                      if (stack[i] == canon) { found = 1; break }
                  }
                  if (!found) { valid = 0; break }
                  for (j = i; j < depth; j++) stack[j] = stack[j + 1]
                  depth--
              } else {
                  depth++
                  stack[depth] = canon
              }
              rest = substr(rest, RSTART + RLENGTH)
          }
          if (!valid || depth != 0) return str

          result = ""
          rest = str
          depth = 0
          sawtag = 0
          while (match(rest, /<\/?(b|bold|strong|i|italic|em|code|u|ins|s|strike|del|mark)>/, arr)) {
              sawtag = 1
              seg = substr(rest, 1, RSTART - 1)
              if (seg != "") {
                  onseq = ""
                  for (i = 1; i <= depth; i++) onseq = onseq style_on[stack[i]]
                  result = result "\033[0m" restore_fg onseq seg
              }
              tagraw  = tolower(arr[0])
              closing = (tagraw ~ /^<\//)
              tagname = tagraw
              gsub(/[<>\/]/, "", tagname)
              canon = style_tag_canon[tagname]
              if (closing) {
                  for (i = depth; i >= 1; i--) {
                      if (stack[i] == canon) {
                          for (j = i; j < depth; j++) stack[j] = stack[j + 1]
                          depth--
                          break
                      }
                  }
              } else {
                  depth++
                  stack[depth] = canon
              }
              rest = substr(rest, RSTART + RLENGTH)
          }
          onseq = ""
          for (i = 1; i <= depth; i++) onseq = onseq style_on[stack[i]]
          if (rest != "" && (depth > 0 || sawtag))
              result = result "\033[0m" restore_fg onseq rest
          else
              result = result rest
          return result
      }

      function render_kbd_inline(str,    result, rest, arr, inner) {
          result = ""
          rest = str
          while (match(rest, /<kbd>([^<]*)<\/kbd>/, arr)) {
              result = result substr(rest, 1, RSTART - 1)
              inner = arr[1]
              gsub(/^[[:space:]]+|[[:space:]]+$/, "", inner)
              gsub(/[[:space:]]+/, " ", inner)
              result = result kbd_on " " inner " " kbd_off
              rest = substr(rest, RSTART + RLENGTH)
          }
          result = result rest
          return result
      }

      function decode_entities(str,    out) {
          out = str
          gsub(/&nbsp;/, " ", out)
          gsub(/&ensp;/, "  ", out)
          gsub(/&emsp;/, "    ", out)
          gsub(/&quot;/, "\"", out)
          gsub(/&#39;/, "'", out)
          gsub(/&apos;/, "'", out)
          gsub(/&lt;/, "<", out)
          gsub(/&gt;/, ">", out)
          gsub(/&copy;/, "©", out)
          gsub(/&reg;/, "®", out)
          gsub(/&trade;/, "™", out)
          gsub(/&mdash;/, "—", out)
          gsub(/&ndash;/, "–", out)
          gsub(/&hellip;/, "…", out)
          gsub(/&amp;/, "\\&", out)
          return out
      }

      function visible_len_ml(str,    parts, n, i, w, maxw) {
          n = split(str, parts, "\n")
          maxw = 0
          for (i = 1; i <= n; i++) {
              w = visible_len(parts[i])
              if (w > maxw) maxw = w
          }
          return maxw
      }

      function domain_match(u, dom) {
          return (u ~ ("(^|https?://|//|\\.)" dom "([/?#]|$)"))
      }
      function domain_icon(url,    u) {
          u = tolower(url)
          if (domain_match(u, "apple\\.com"))         return " "
          if (domain_match(u, "discord\\.com") || \
              domain_match(u, "discord\\.gg"))          return "󰙯 "   
          if (domain_match(u, "github\\.com"))        return "󰊤 "
          if (domain_match(u, "gitlab\\.com"))        return "󰮠 "
          if (domain_match(u, "google\\.com"))        return "󰊭 "
          if (domain_match(u, "ycombinator\\.com"))   return " "
          if (domain_match(u, "linkedin\\.com"))      return "󰌻 "
          if (domain_match(u, "microsoft\\.com"))     return " "
          if (domain_match(u, "neovim\\.io"))         return " "
          if (domain_match(u, "reddit\\.com"))        return "󰑍 "
          if (domain_match(u, "slack\\.com"))         return "󰒱 "
          if (domain_match(u, "stackoverflow\\.com")) return "󰓌 "
          if (domain_match(u, "steampowered\\.com"))  return " "
          if (domain_match(u, "twitter\\.com"))       return " "
          if (domain_match(u, "wikipedia\\.org"))     return "󰖬 "
          if (domain_match(u, "x\\.com"))             return " "
          if (u ~ /youtube[^.]*\.com/)                return "󰗃 "
          if (domain_match(u, "youtu\\.be"))          return "󰗃 "
          if (domain_match(u, "apple\\.com"))         return " "
          if (domain_match(u, "bitbucket\\.org"))       return " "
          if (domain_match(u, "codepen\\.io"))          return " "
          if (domain_match(u, "npmjs\\.com"))           return "󰎙 "
          if (domain_match(u, "docker\\.com"))          return "󰡨 "
          if (domain_match(u, "kubernetes\\.io"))       return " "
          if (domain_match(u, "vim\\.org"))             return " "
          if (domain_match(u, "archlinux\\.org"))       return "󰣇 "
          if (domain_match(u, "ubuntu\\.com"))          return "󰕈 "
          if (domain_match(u, "debian\\.org"))          return "󰣚 "
          if (domain_match(u, "fedoraproject\\.org"))   return "󰣛 "
          if (domain_match(u, "python\\.org"))          return "󰌠 "
          if (domain_match(u, "pypi\\.org"))            return "󰌠 "
          if (domain_match(u, "rust-lang\\.org"))       return "󱘗 "
          if (domain_match(u, "crates\\.io"))           return "󱘗 "
          if (domain_match(u, "docs\\.rs"))             return "󱘗 "
          if (domain_match(u, "go\\.dev"))              return "󰟓 "
          if (domain_match(u, "golang\\.org"))          return "󰟓 "
