        _CSS_COLORS_INIT=1
    }


    function is_valid_color() {
        local val="${1,,}"
        [[ "$val" == "none" || "$val" == "clear" ]] && return 0
        [[ "$val" =~ ^#([a-fA-F0-9]{6}|[a-fA-F0-9]{3})$ ]] && return 0
        [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 0 && val <= 255 )) && return 0
        case "$val" in
            black|red|green|yellow|blue|magenta|purple|cyan|white|gray|grey) return 0 ;;
            brightblack|brightred|brightgreen|brightyellow|brightblue|brightmagenta|brightpurple|brightcyan|brightwhite) return 0 ;;
        esac
        _css_init
        [[ -n "${_CSS_COLORS[$val]:-}" ]] && return 0
        return 1
    }


    function strict_bool() {
        local val="${1,,}"
        case "$val" in
            true|1|yes) printf "true" ;;
            false|0|no) printf "false" ;;
            *) printf "INVALID" ;;
        esac
    }

    function _color_seq() {
        local val="${1,,}" layer="$2"
        [[ -z "$val" || "$val" == "none" || "$val" == "clear" ]] && return
        if [[ "$val" == \#* ]]; then
            local hex="${val#\#}"
            [[ ${#hex} -eq 3 ]] && hex="${hex:0:1}${hex:0:1}${hex:1:1}${hex:1:1}${hex:2:1}${hex:2:1}"
            local r=$(( 16#${hex:0:2} ))
            local g=$(( 16#${hex:2:2} ))
            local b=$(( 16#${hex:4:2} ))
            printf "${ESC}[%d;2;%d;%d;%dm" "$layer" "$r" "$g" "$b"
        elif [[ "$val" =~ ^[0-9]+$ ]]; then
            printf "${ESC}[%d;5;%dm" "$layer" "$val"
        else
            local base=0
            [[ "$layer" == 38 ]] && base=30
            [[ "$layer" == 48 ]] && base=40
            case "$val" in
                black)                 printf "${ESC}[%dm" $((base + 0)) ;;
                red)                   printf "${ESC}[%dm" $((base + 1)) ;;
                green)                 printf "${ESC}[%dm" $((base + 2)) ;;
                yellow)                printf "${ESC}[%dm" $((base + 3)) ;;
                blue)                  printf "${ESC}[%dm" $((base + 4)) ;;
                magenta|purple)        printf "${ESC}[%dm" $((base + 5)) ;;
                cyan)                  printf "${ESC}[%dm" $((base + 6)) ;;
                white)                 printf "${ESC}[%dm" $((base + 7)) ;;
                gray|grey|brightblack) printf "${ESC}[%dm" $((base + 60)) ;;
                brightred)             printf "${ESC}[%dm" $((base + 61)) ;;
                brightgreen)           printf "${ESC}[%dm" $((base + 62)) ;;
                brightyellow)          printf "${ESC}[%dm" $((base + 63)) ;;
                brightblue)            printf "${ESC}[%dm" $((base + 64)) ;;
                brightmagenta|brightpurple) printf "${ESC}[%dm" $((base + 65)) ;;
                brightcyan)            printf "${ESC}[%dm" $((base + 66)) ;;
                brightwhite)           printf "${ESC}[%dm" $((base + 67)) ;;
                *)
                    _css_init
                    local hex="${_CSS_COLORS[$val]:-}"
                    if [[ -n "$hex" ]]; then
                        local r=$(( 16#${hex:0:2} ))
                        local g=$(( 16#${hex:2:2} ))
                        local b=$(( 16#${hex:4:2} ))
                        printf "${ESC}[%d;2;%d;%d;%dm" "$layer" "$r" "$g" "$b"
                    fi
                    ;;
            esac
        fi
    }

    function _list_color_names() {
        _css_init
        local names=(
            black red green yellow blue magenta purple cyan white gray grey
            brightblack brightred brightgreen brightyellow brightblue
            brightmagenta brightpurple brightcyan brightwhite
        )
        names+=("${!_CSS_COLORS[@]}")
        printf '%s\n' "${names[@]}" | sort -u | paste -sd, - | sed 's/,/, /g' 
    }


    function make_ansi() {
        local fg="$1" bg="$2"
        _color_seq "$fg" 38
        _color_seq "$bg" 48
    }

    local limit=1          
    local height=10
    local cursor_char="> "
    local header="Choose: "
    local timeout=0
    
    local cursor_prefix="• " 
    local selected_prefix="✓ "
    local unselected_prefix="• "
    
    local ordered=false
    local show_help=true
    local pre_selected=""
    local output_delimiter=$'\n' 
    local input_delimiter=$'\n'
    local label_delimiter=""
    local strip_ansi_flag=false
    local select_if_one=false
    
    local padding="0 0 0 0"

    local c_cursor_fg="212"     ; local c_cursor_bg=""
    local c_header_fg="99"      ; local c_header_bg=""
    local c_item_fg=""          ; local c_item_bg=""     
    local c_selected_fg="212"   ; local c_selected_bg="" 
    
    function show_help_panel() {
        cat <<EOF
Usage: bash-utils choose [<options> ...] [flags]

Choose an option from a list of choices

Arguments:
  [<options> ...]    Options to choose from.

Flags:
  -h, --help                        Show context-sensitive help.
      --ordered                     Maintain the order of the selected options
      --height=10                   Height of the list
      --cursor="> "                 Prefix to show on item that corresponds to the cursor position
      --[no-]show-help              Show help keybinds
      --timeout=0s                  Timeout until choose returns selected element
      --header="Choose:"            Header value
      --cursor-prefix="• "          Prefix to show on the cursor item (hidden if limit is 1)
      --selected-prefix="✓ "        Prefix to show on selected items (hidden if limit is 1)
      --unselected-prefix="• "      Prefix to show on unselected items (hidden if limit is 1)
      --selected=,...               Options that should start as selected (selects all if given *)
      --input-delimiter="\n"        Option delimiter when reading from STDIN
      --output-delimiter="\n"       Option delimiter when writing to STDOUT
      --label-delimiter=""          Allows to set a delimiter, so options can be set as label:value
      --[no-]strip-ansi             Strip ANSI sequences when reading from STDIN

Selection
  --limit=1                  Maximum number of options to pick
  --no-limit                 Pick unlimited number of options (ignores limit)
  --select-if-one            Select the given option if there is only one

Style Flags (Colors ONLY accept 0-255 or #RRGGBB):
  --padding="0 0"               Padding CSS (top right bottom left)
  --cursor.foreground="212"     Foreground Color
  --cursor.background=""        Background Color
  --header.foreground="99"      Foreground Color
  --header.background=""        Background Color
  --item.foreground=""          Foreground Color
  --item.background=""          Background Color
  --selected.foreground="212"   Foreground Color
  --selected.background=""      Background Color
EOF
    }

    local args_options=()
    
    while [[ $# -gt 0 ]]; do
        local arg="$1"
        local key="$1"
        local val=""
        local has_val="false"

        if [[ "$key" == *=* ]]; then
            val="${key#*=}"
            key="${key%%=*}"
            has_val="true"
        fi

        case "$key" in
            -h|--help)                  [[ "$has_val" == "true" ]] && die "La bandera '${key}' no acepta valores."; show_help_panel; return 0 ;;
            --no-limit)                 [[ "$has_val" == "true" ]] && die "La bandera '${key}' no acepta valores."; limit=0; shift; continue ;;
            --ordered)                  [[ "$has_val" == "true" ]] && die "La bandera '${key}' no acepta valores."; ordered=true; shift; continue ;;
            --no-show-help)             [[ "$has_val" == "true" ]] && die "La bandera '${key}' no acepta valores."; show_help=false; shift; continue ;;
            --show-help)                [[ "$has_val" == "true" ]] && die "La bandera '${key}' no acepta valores."; show_help=true; shift; continue ;;
            --no-strip-ansi)            [[ "$has_val" == "true" ]] && die "La bandera '${key}' no acepta valores."; strip_ansi_flag=false; shift; continue ;;
            --strip-ansi)               [[ "$has_val" == "true" ]] && die "La bandera '${key}' no acepta valores."; strip_ansi_flag=true; shift; continue ;;
            --select-if-one)            [[ "$has_val" == "true" ]] && die "La bandera '${key}' no acepta valores."; select_if_one=true; shift; continue ;;
            
            --limit|--height|--cursor|--header|--timeout|--cursor-prefix|--selected-prefix|--unselected-prefix|--selected|--input-delimiter|--output-delimiter|--label-delimiter|--padding|--cursor.foreground|--cursor.background|--header.foreground|--header.background|--item.foreground|--item.background|--selected.foreground|--selected.background)
                if [[ "$has_val" == "false" ]]; then
                    if [[ $# -lt 2 || "$2" == --* ]]; then
                        die "La bandera '${key}' requiere un valor asignado."
                    fi
                    val="$2"
                    shift 2
                else
                    shift
                fi
                
                case "$key" in
                    --limit|--height)
                        [[ ! "$val" =~ ^[0-9]+$ ]] && die "Valor para '${key}' inválido. Recibido: '${val}'. Literal esperado: Entero >= 0."
                        [[ "$key" == "--limit" ]] && limit="$val" || height="$val"
                        ;;
                    --timeout)
                        val="${val%s}"
                        [[ ! "$val" =~ ^[0-9]+$ ]] && die "Valor para '--timeout' inválido. Recibido: '${val}'. Literal esperado: Entero >= 0."
                        timeout="$val"
                        ;;
                    --padding)
                        [[ ! "$val" =~ ^[0-9]+([[:space:]]+[0-9]+){0,3}$ ]] && die "Padding inválido en '${key}'. Recibido: '${val}'. Literal esperado: 1 a 4 números."
                        padding="$val"
                        ;;
                    --cursor)               cursor_char="$val" ;;
                    --header)               header="$val" ;;
                    --cursor-prefix)        cursor_prefix="$val" ;;
                    --selected-prefix)      selected_prefix="$val" ;;
                    --unselected-prefix)    unselected_prefix="$val" ;;
                    --selected)             pre_selected="$val" ;;
                    --input-delimiter)      input_delimiter="$val" ;;
                    --output-delimiter)     output_delimiter="$val" ;;
                    --label-delimiter)      label_delimiter="$val" ;;

                    # Colores
                    --cursor.foreground|--cursor.background|--header.foreground|--header.background|--item.foreground|--item.background|--selected.foreground|--selected.background)
                        if ! is_valid_color "$val"; then
                            die "Color inválido recibido: '${val}'. Literales esperados: #HEX, 0-255 o nombres, colores disponibles: $(_list_color_names)"
                        fi

                        case "$key" in
                            --cursor.foreground)   c_cursor_fg="$val" ;;
                            --cursor.background)   c_cursor_bg="$val" ;;
                            --header.foreground)   c_header_fg="$val" ;;
                            --header.background)   c_header_bg="$val" ;;
                            --item.foreground)     c_item_fg="$val" ;;
                            --item.background)     c_item_bg="$val" ;;
                            --selected.foreground) c_selected_fg="$val" ;;
                            --selected.background) c_selected_bg="$val" ;;
                        esac
                        ;;
                esac
                ;;
            
            --*) 
                die "Bandera desconocida o no soportada: '${key}'. Usa '--help' para ver la lista de banderas permitidas."
                ;;
                
            *) 
                args_options+=("$arg")
                shift 
                ;;
        esac
    done

    [[ "$output_delimiter" == "\\n" ]] && output_delimiter=$'\n'
    [[ "$input_delimiter" == "\\n" ]] && input_delimiter=$'\n'

    local raw_options=()
    if [[ ${#args_options[@]} -gt 0 ]]; then
        raw_options=("${args_options[@]}")
    fi

    if [ ! -t 0 ]; then
        if [[ "$input_delimiter" == $'\n' ]]; then
            while IFS= read -r line || [[ -n "$line" ]]; do
                raw_options+=("$line")
            done
        else
            local raw_input
            read -rd '' raw_input
            local old_ifs=$IFS
            IFS="$input_delimiter" read -ra piped_arr <<< "$raw_input"
            IFS=$old_ifs
            for item in "${piped_arr[@]}"; do
                [[ -n "$item" ]] && raw_options+=("$item")
            done
        fi
        exec 0< /dev/tty
    fi

    if [[ ${#raw_options[@]} -eq 0 ]]; then
        die "No options provided. Please provide options or pipe them. See --help."
    fi

    local options=()
    local values=()

    for ((i=0; i<${#raw_options[@]}; i++)); do
        [[ "$strip_ansi_flag" == "true" ]] && raw_options[$i]=$(strip_ansi "${raw_options[$i]}")
        
        if [[ -n "$label_delimiter" && "${raw_options[$i]}" == *"$label_delimiter"* ]]; then
            options+=("${raw_options[$i]%%${label_delimiter}*}")
            values+=("${raw_options[$i]#*${label_delimiter}}")
        else
            options+=("${raw_options[$i]}")
            values+=("${raw_options[$i]}")
        fi
    done

    local total=${#options[@]}

    if [[ "$select_if_one" == "true" && $total -eq 1 ]]; then
        printf "%s%s" "${values[0]}" "${output_delimiter}"
        return 0
    fi

    local selected_status=()
    local current_idx=0
    local scroll_offset=0
    local final_selection="" 
    
    for ((i=0; i<total; i++)); do selected_status[$i]=0; done

    local first_match=-1
    if [[ -n "$pre_selected" ]]; then
        if [[ "$pre_selected" == "*" ]]; then
            for ((i=0; i<total; i++)); do selected_status[$i]=1; done
            first_match=0
        else
            local old_ifs=$IFS
            IFS=',' read -ra pre_arr <<< "$pre_selected"
            IFS=$old_ifs
            for item in "${pre_arr[@]}"; do
                item=$(printf '%s' "$item" | xargs)
                for ((i=0; i<total; i++)); do
                    if [[ "${values[$i]}" == "$item" || "${options[$i]}" == "$item" || "${values[$i]}" == *" $item" || "${options[$i]}" == *" $item" ]]; then
                        selected_status[$i]=1
                        [[ $first_match -eq -1 ]] && first_match=$i
                    fi
                done
            done
        fi
    fi

    [[ $first_match -ne -1 ]] && current_idx=$first_match

    local s_cursor="$(make_ansi "$c_cursor_fg" "$c_cursor_bg")"
    local s_header="$(make_ansi "$c_header_fg" "$c_header_bg")"
    local s_item="$(make_ansi "$c_item_fg" "$c_item_bg")"
    local s_selected="$(make_ansi "$c_selected_fg" "$c_selected_bg")"
    local reset="${ESC}[0m"
    local dimmed="${ESC}[2m"

    local pad_t=0 pad_r=0 pad_b=0 pad_l=0
    read -ra _pv <<< "$padding"
    case "${#_pv[@]}" in
        1) pad_t="${_pv[0]}"; pad_r="${_pv[0]}"; pad_b="${_pv[0]}"; pad_l="${_pv[0]}" ;;
        2) pad_t="${_pv[0]}"; pad_b="${_pv[0]}"; pad_r="${_pv[1]}"; pad_l="${_pv[1]}" ;;
        3) pad_t="${_pv[0]}"; pad_r="${_pv[1]}"; pad_l="${_pv[1]}"; pad_b="${_pv[2]}" ;;
        4) pad_t="${_pv[0]}"; pad_r="${_pv[1]}"; pad_b="${_pv[2]}"; pad_l="${_pv[3]}" ;;
    esac

    local pad_indent=""
    for (( _p=0; _p<pad_l; _p++ )); do pad_indent+=" "; done

    function page_right() {
        local current_page=$(( current_idx / height ))
        local total_pages=$(( (total + height - 1) / height ))
        local rel_idx=$(( current_idx % height ))
        
        ((current_page++))
        if (( current_page >= total_pages )); then current_page=0; fi
        
        current_idx=$(( current_page * height + rel_idx ))
        if (( current_idx >= total )); then current_idx=$(( total - 1 )); fi
    }

    function page_left() {
        local current_page=$(( current_idx / height ))
        local total_pages=$(( (total + height - 1) / height ))
        local rel_idx=$(( current_idx % height ))
        
        ((current_page--))
        if (( current_page < 0 )); then current_page=$(( total_pages - 1 )); fi
        
        current_idx=$(( current_page * height + rel_idx ))
        if (( current_idx >= total )); then current_idx=$(( total - 1 )); fi
    }

    local header_lines=0
    if [[ -n "$header" ]]; then
        header_lines=$(printf '%s' "$header" | grep -c "^")
    fi
    
    local total_pages=$(( (total + height - 1) / height ))
    local page_lines=0
    [[ $total_pages -gt 1 ]] && page_lines=2
    
    local footer_lines=0
    [[ "$show_help" == "true" ]] && footer_lines=1
    
    local total_lines=$(( pad_t + header_lines + height + page_lines + footer_lines + pad_b ))

    local alloc_str=""
    for ((i=0; i<total_lines; i++)); do alloc_str+="${NL}"; done
    printf '%s' "${alloc_str}${ESC}[${total_lines}A" >&2

    local stty_orig
    stty_orig=$(stty -g < /dev/tty 2>/dev/null)
    stty -echo -icanon -isig < /dev/tty 2>/dev/null

    local _interrupted=0
    local needs_redraw=true

    trap '_interrupted=1' SIGINT TERM
    trap 'needs_redraw=true' SIGWINCH

    function cleanup() {
        while read -rsn1 -t 0.05 _trash < /dev/tty 2>/dev/null; do :; done
        if [[ -n "$stty_orig" ]]; then
            stty "$stty_orig" < /dev/tty 2>/dev/null
        else
            stty sane < /dev/tty 2>/dev/null
        fi
        tput cnorm >&2
        printf '%s' "${ESC}[?7h${ESC}[?1000l${ESC}[?1002l${ESC}[?1006l" >&2
    }

    function _clear_and_exit() {
        local clear_frame=""
        for ((k=0; k<total_lines; k++)); do clear_frame+="${ESC}[K${NL}"; done
        printf '%s' "${clear_frame}${ESC}[${total_lines}A" >&2
        cleanup
    }

    tput civis >&2
    printf '%s' "${ESC}[?7l" >&2

    function draw() {
        scroll_offset=$(( (current_idx / height) * height ))
        local frame="${reset}"

        for (( _p=0; _p<pad_t; _p++ )); do frame+="${ESC}[K${NL}"; done

        if [[ -n "$header" ]]; then
            frame+="${pad_indent}${s_header}${header}${reset}${ESC}[K${NL}"
        fi

        for (( i=0; i<height; i++ )); do
            local idx=$(( scroll_offset + i ))
            
            if (( idx >= total )); then
                frame+="${ESC}[K${NL}"
                continue
            fi

            local item="${options[$idx]}"
            local is_sel=${selected_status[$idx]}
            local prefix=""
            local line_color="$s_item"
            local line_cursor="  "

            if (( idx == current_idx )); then
                line_cursor="${s_cursor}${cursor_char}${reset}"
                if [[ $limit -eq 1 ]]; then
                    line_color="$s_cursor" 
                fi
            else
                printf -v line_cursor "%*s" ${#cursor_char} ""
            fi

            if [[ $limit -ne 1 ]]; then
                if (( is_sel == 1 )); then
                    prefix="${s_selected}${selected_prefix}${reset}"
                    line_color="$s_selected"
                else
                    if (( idx == current_idx )); then
                        prefix="${s_cursor}${cursor_prefix}${reset}"
                    else
                        prefix="${dimmed}${unselected_prefix}${reset}"
                    fi
                fi
            fi

            frame+="${pad_indent}${line_cursor}${prefix}${line_color}${item}${reset}${ESC}[K${NL}"
        done

        if [[ $total_pages -gt 1 ]]; then
            frame+="${ESC}[K${NL}"
            local dots=""
            local current_page=$(( current_idx / height ))
            for (( p=0; p<total_pages; p++ )); do
                if (( p == current_page )); then
                    dots+="${s_cursor}•${reset}"
                else
                    dots+="${dimmed}•${reset}"
                fi
            done
            frame+="${pad_indent}  ${dots}${ESC}[K${NL}"
        fi

        if [[ "$show_help" == "true" ]]; then
            local help_msg=""
            if [[ $limit -eq 1 ]]; then
                help_msg="${dimmed}←/↓/↑/→ nav • enter select${reset}"
            else
                help_msg="${dimmed}←/↓/↑/→ nav • space toggle • ctrl+a all • enter confirm${reset}"
            fi
            frame+="${pad_indent}${help_msg}${ESC}[K${NL}"
        fi

        for (( _p=0; _p<pad_b; _p++ )); do frame+="${ESC}[K${NL}"; done

        frame+="${ESC}[${total_lines}A"
        printf '%s' "${frame}" >&2
    }

    local start_time=$(date +%s)

    while true; do
        if [[ "$needs_redraw" == "true" ]]; then
            draw
            needs_redraw=false
        fi

        local read_opts=("-rsn1" "-t" "0.05")
        
        if [[ $timeout -gt 0 ]]; then
            local now=$(date +%s)
            local remain=$(( timeout - (now - start_time) ))
            if (( remain <= 0 )); then _clear_and_exit; return 124; fi
        fi

        local _read_status=0
        IFS= read "${read_opts[@]}" key < /dev/tty || _read_status=$?

        if [[ $_interrupted -eq 1 ]]; then
            _clear_and_exit
            return 130
        fi

        if [[ $_read_status -ne 0 ]]; then continue; fi

        needs_redraw=true

        case "$key" in
            $'\x03'|$'\x04'|'q') 
                _clear_and_exit
                return 130 
                ;;
            $'\x1b')
                local c1="" c2="" c3="" seq=""
                IFS= read -rsn1 -t 0.15 c1 < /dev/tty || true
                if [[ -z "$c1" ]]; then continue; fi

                if [[ "$c1" == "[" || "$c1" == "O" ]]; then
                    IFS= read -rsn1 -t 0.15 c2 < /dev/tty || true
                    if [[ -z "$c2" ]]; then continue; fi

                    seq="${c1}${c2}"
                    if [[ "$c2" =~ [0-9] ]]; then
                        IFS= read -rsn1 -t 0.15 c3 < /dev/tty || true
                        seq="${seq}${c3}"
                    fi

                    case "$seq" in
                        "[A"|"OA") ((current_idx--)); if ((current_idx < 0)); then current_idx=$((total - 1)); fi ;;
                        "[B"|"OB") ((current_idx++)); if ((current_idx >= total)); then current_idx=0; fi ;;
                        "[C"|"OC") page_right ;;
                        "[D"|"OD") page_left ;;
                    esac
                fi
                ;;
            'k') ((current_idx--)); if ((current_idx < 0)); then current_idx=$((total - 1)); fi ;;
            'j') ((current_idx++)); if ((current_idx >= total)); then current_idx=0; fi ;;
            'l') page_right ;;
            'h') page_left ;;
            
            $'\x01') 
                if [[ $limit -ne 1 ]]; then
                    local all_sel=true
                    for ((i=0; i<total; i++)); do
                        if (( selected_status[i] == 0 )); then
                            all_sel=false
                            break
                        fi
                    done
                    
                    if [[ "$all_sel" == "true" ]]; then
                        for ((i=0; i<total; i++)); do selected_status[$i]=0; done
                    else
                        for ((i=0; i<total; i++)); do selected_status[$i]=1; done
                    fi
                fi
                ;;

            " ") 
                if [[ $limit -ne 1 ]]; then
                    selected_status[$current_idx]=$(( 1 - selected_status[$current_idx] ))
                fi
                ;;
            
            ""|$'\x0a'|$'\x0d') 
                if [[ $limit -eq 1 ]]; then
                    final_selection="${values[$current_idx]}"
                else
                    local first=true
                    
                    if [[ "$ordered" == "true" ]]; then
                        for ((i=0; i<total; i++)); do
                            if (( selected_status[i] == 1 )); then
                                if [ "$first" = true ]; then
                                    final_selection="${values[$i]}"
                                    first=false
                                else
                                    final_selection+="${output_delimiter}${values[$i]}"
                                fi
                            fi
                        done
                    else
                        for ((i=0; i<total; i++)); do
                            if (( selected_status[i] == 1 )); then
                                if [ "$first" = true ]; then
                                    final_selection="${values[$i]}"
                                    first=false
                                else
                                    final_selection+="${output_delimiter}${values[$i]}"
                                fi
                            fi
                        done
                    fi
                fi
                break 
                ;;
        esac
    done

    _clear_and_exit
    
    if [[ -n "$final_selection" ]]; then
        printf "%s%s" "$final_selection" "${output_delimiter}"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then 
    cmd_choose "${@}"
fi
