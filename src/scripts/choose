#!/usr/bin/env bash

function cmd_choose() {
    local ESC=$'\e'
    local NL=$'\n'
    local CR=$'\r'

    function die() {
        printf '%s\n' "${ESC}[31m[!] Error: $1${ESC}[0m" >&2
        exit 1
    }


    function strip_ansi() {
        local input
        if [[ $# -gt 0 ]]; then
            input="$*"
        else
            IFS= read -r -d '' input
        fi

        local out=""
        local -i state=0 
        local -r ESC=$'\x1b'
        local -r BEL=$'\x07'
        local -i i len=${#input}
        local c

        for (( i=0; i<len; i++ )); do
            c="${input:i:1}"
            case "$state" in
                0) 
                    case "$c" in
                        "$ESC") state=1 ;;
                        "$BEL") : ;;
                        *) out+="$c" ;;
                    esac
                    ;;
                1)
                    case "$c" in
                        '[') state=2 ;;
                        ']') state=3 ;;
                        '%'|'('|')'|'0'|'3'|'5'|'6'|'#') state=5 ;;
                        "$BEL"|'A'|'B'|'C'|'D'|'E'|'H'|'I'|'J'|'K'|'M'|'N'|'O'|'S'|'T'|'Z'|'c'|'s'|'u'|'1'|'2'|'7'|'8'|'<'|'='|'>')
                            state=0 ;;
                        *)
                            out+="${ESC}${c}"
                            state=0
                            ;;
                    esac
                    ;;
                2) 
                    case "$c" in
                        ';'|'?'|[0-9]) : ;;
                        *) state=0 ;;
                    esac
                    ;;
                3) 
                    case "$c" in
                        [0-9]) state=4 ;;
                        *) state=0 ;;
                    esac
                    ;;
                4) 
                    case "$c" in
                        "$BEL") state=0 ;;
                        "$ESC") state=5 ;;
                    esac
                    ;;
                5) 
                    state=0
                    ;;
            esac
        done

        printf '%s' "$out"
    }

