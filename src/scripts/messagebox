#!/usr/bin/env bash

function strip_ansi() {
    local input
    if [[ $# -gt 0 ]]; then
        input="$*"
    else
        IFS= read -r -d '' input
    fi

    local out=""
    local -i state=0 
    local -r ESC=$'\x1b'
    local -r BEL=$'\x07'
    local -i i len=${#input}
    local c

    for (( i=0; i<len; i++ )); do
        c="${input:i:1}"
        case "$state" in
            0) 
                case "$c" in
                    "$ESC") state=1 ;;
                    "$BEL") : ;;
                    *) out+="$c" ;;
                esac
                ;;
            1) 
                case "$c" in
                    '[') state=2 ;;
                    ']') state=3 ;;
                    '%'|'('|')'|'0'|'3'|'5'|'6'|'#') state=5 ;;
                    "$BEL"|'A'|'B'|'C'|'D'|'E'|'H'|'I'|'J'|'K'|'M'|'N'|'O'|'S'|'T'|'Z'|'c'|'s'|'u'|'1'|'2'|'7'|'8'|'<'|'='|'>')
                        state=0 ;;
                    *)
                        out+="${ESC}${c}"
                        state=0
                        ;;
                esac
                ;;
            2) 
                case "$c" in
                    ';'|'?'|[0-9]) : ;;
                    *) state=0 ;;
                esac
                ;;
            3) 
                case "$c" in
                    [0-9]) state=4 ;;
                    *) state=0 ;;
                esac
                ;;
            4) 
                case "$c" in
                    "$BEL") state=0 ;;
                    "$ESC") state=5 ;;
                esac
                ;;
            5) 
                state=0
                ;;
        esac
    done

    printf '%s' "$out"
}

visible_width() {
    local clean=$(strip_ansi "$1")
    if command -v wc &> /dev/null && wc -L <<< "test" &> /dev/null; then
        printf "%s" "$clean" | wc -L
    else
        echo ${#clean}
    fi
}

ansi_aware_wrap() {
    local text="$1"
    local width="$2"

    [[ -z "$width" || "$width" -lt 1 ]] && width=1

    printf '%s\n' "$text" | awk -v width="$width" '
    function visible_length(str,    n, i, c, out, state, ESC, BEL) {
        ESC = sprintf("%c", 27)
        BEL = sprintf("%c", 7)
        state = 0
        n = length(str)
        out = 0
        for (i = 1; i <= n; i++) {
            c = substr(str, i, 1)
            if (state == 0) {
                if (c == ESC) state = 1
                else if (c != BEL) out++
            }
            else if (state == 1) {
                if (c == "[") state = 2
                else if (c == "]") state = 3
                else if (c ~ /^[%()0356#]$/) state = 5
                else if (c == BEL || c ~ /^[ABCDEHIJKMNOSTZcsu1278<=>]$/) state = 0
                else { out += 2; state = 0 }   # secuencia no reconocida: se conserva literal (ESC+c)
            }
            else if (state == 2) {
                if (!(c == ";" || c == "?" || c ~ /[0-9]/)) state = 0
            }
            else if (state == 3) {
                state = (c ~ /[0-9]/) ? 4 : 0
            }
            else if (state == 4) {
                if (c == BEL) state = 0
                else if (c == ESC) state = 5
            }
            else if (state == 5) {
                state = 0
            }
        }
        return out
    }

    {
        line = $0
        gsub(/\t/, "    ", line)
        if (length(line) == 0) { print ""; next }

        current_line = ""
        current_len = 0
        
        while (length(line) > 0) {
            match(line, /[^[:space:]]+/)
            if (RSTART == 0) { chunk = line; line = "" } 
            else {
                gap = substr(line, 1, RSTART - 1)
                word = substr(line, RSTART, RLENGTH)
                chunk = gap word
                line = substr(line, RSTART + RLENGTH)
            }

            chunk_len = visible_length(chunk)
            space_left = width - current_len

            if (chunk_len <= space_left) {
                current_line = current_line chunk
                current_len += chunk_len
            } else {
                if (visible_length(word) > width) {
                    needed = width - current_len
                    if (needed < 1) needed = 1
                    part_to_fill = substr(chunk, 1, needed)
                    print current_line part_to_fill
                    remaining = substr(chunk, needed + 1)
                    while (visible_length(remaining) > width) {
                        cut = width; if (cut < 1) cut = 1
                        print substr(remaining, 1, cut)
                        remaining = substr(remaining, cut + 1)
                    }
                    current_line = remaining
                    current_len = visible_length(remaining)
                } else {
                    if (current_len > 0) print current_line
                    if (gap != "" && current_len > 0) {
                        current_line = word
                        current_len = visible_length(word)
                    } else {
                        current_line = chunk
                        current_len = chunk_len
                    }
                }
            }
        }
        if (length(current_line) > 0) print current_line
    }'
}

