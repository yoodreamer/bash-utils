}

function _list_color_names() {
    _css_init
    local names=(
        black red green yellow blue magenta purple cyan white gray grey
        brightblack brightred brightgreen brightyellow brightblue
        brightmagenta brightpurple brightcyan brightwhite none clear
    )
    names+=("${!_CSS_COLORS[@]}")
    printf '%s\n' "${names[@]}" | sort -u | paste -sd, - | sed 's/,/, /g'
}

function is_valid_color() {
    local val="${1,,}"
    [[ "$val" == "none" || "$val" == "clear" ]] && return 0
    [[ "$val" =~ ^#([a-fA-F0-9]{6}|[a-fA-F0-9]{3})$ ]] && return 0
    [[ "$val" =~ ^[0-9]{1,3}\;[0-9]{1,3}\;[0-9]{1,3}$ ]] && return 0
    [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 0 && val <= 255 )) && return 0
    case "$val" in
        black|red|green|yellow|blue|magenta|purple|cyan|white|gray|grey) return 0 ;;
        brightblack|brightred|brightgreen|brightyellow|brightblue|brightmagenta|brightpurple|brightcyan|brightwhite) return 0 ;;
    esac
    _css_init
    [[ -n "${_CSS_COLORS[$val]:-}" ]] && return 0
    return 1
}

function _assert_literal() {
    local val="$1" flag="$2"
    shift 2
    local -a allowed=("$@")
    local opt
    for opt in "${allowed[@]}"; do
        [[ "$val" == "$opt" ]] && return 0
    done
    local IFS_bak="$IFS"
    IFS='|'
    local list="${allowed[*]}"
    IFS="$IFS_bak"
    echo "Error: Invalid value for ${flag}: '${val}'. Expected one of: ${list}" >&2
    return 1
}


function _color_seq() {
    local val="${1,,}" layer="$2"
    [[ -z "$val" || "$val" == "none" || "$val" == "clear" ]] && return

    if [[ "$val" == \#* ]]; then
        local hex="${val#\#}"
        [[ ${#hex} -eq 3 ]] && hex="${hex:0:1}${hex:0:1}${hex:1:1}${hex:1:1}${hex:2:1}${hex:2:1}"
        local r=$(( 16#${hex:0:2} ))
        local g=$(( 16#${hex:2:2} ))
        local b=$(( 16#${hex:4:2} ))
        printf "\033[%d;2;%d;%d;%dm" "$layer" "$r" "$g" "$b"
        return
    fi

    if [[ "$val" =~ ^[0-9]{1,3}\;[0-9]{1,3}\;[0-9]{1,3}$ ]]; then
        printf "\033[%d;2;%sm" "$layer" "$val"
        return
    fi

    if [[ "$val" =~ ^[0-9]+$ ]]; then
        printf "\033[%d;5;%dm" "$layer" "$val"
        return
    fi

    local base=0
    [[ "$layer" == 38 ]] && base=30
    [[ "$layer" == 48 ]] && base=40

    case "$val" in
        black)                 printf "\033[%dm" $((base + 0)) ;;
        red)                   printf "\033[%dm" $((base + 1)) ;;
        green)                 printf "\033[%dm" $((base + 2)) ;;
        yellow)                printf "\033[%dm" $((base + 3)) ;;
        blue)                  printf "\033[%dm" $((base + 4)) ;;
        magenta|purple)        printf "\033[%dm" $((base + 5)) ;;
        cyan)                  printf "\033[%dm" $((base + 6)) ;;
        white)                 printf "\033[%dm" $((base + 7)) ;;
        gray|grey|brightblack) printf "\033[%dm" $((base + 60)) ;;
        brightred)             printf "\033[%dm" $((base + 61)) ;;
        brightgreen)           printf "\033[%dm" $((base + 62)) ;;
        brightyellow)          printf "\033[%dm" $((base + 63)) ;;
        brightblue)            printf "\033[%dm" $((base + 64)) ;;
        brightmagenta|brightpurple) printf "\033[%dm" $((base + 65)) ;;
        brightcyan)            printf "\033[%dm" $((base + 66)) ;;
        brightwhite)           printf "\033[%dm" $((base + 67)) ;;
        *)
            _css_init
            local css_hex="${_CSS_COLORS[$val]:-}"
            if [[ -n "$css_hex" ]]; then
                local r=$(( 16#${css_hex:0:2} ))
                local g=$(( 16#${css_hex:2:2} ))
                local b=$(( 16#${css_hex:4:2} ))
                printf "\033[%d;2;%d;%d;%dm" "$layer" "$r" "$g" "$b"
            fi
            ;;
    esac
}

get_style_seq() {
    local type="$1"
    local code="$2"
    if [[ -z "$code" ]]; then printf ""; return 0; fi

    case "$type" in
        mode)
            case "$code" in
                bold) printf '\033[1m' ;;
                italic) printf '\033[3m' ;;
                underline) printf '\033[4m' ;;
                strike) printf '\033[9m' ;;
            esac
            ;;
        fg|bg)
            if ! is_valid_color "$code"; then
                echo "Error: color inválido '${code}'. Acepta 0-255, #RRGGBB, #RGB, R;G;B, none/clear, nombres CSS (coral, mediumseagreen...) o nombres básicos (red, yellow, brightblue...). Colores disponibles: $(_list_color_names)" >&2
                return 1
            fi
            local prefix="38"
            [[ "$type" == "bg" ]] && prefix="48"
            _color_seq "$code" "$prefix"
            ;;
    esac
}

function messagebox() { 

    function show_help() {
        cat <<EOF
Usage: bash-utils messagebox [flags] [Message]
       messagebox [flags] [Title] [Message]

Flags:
  -h, --help                      Show help
  -t, --title=""                  Box title
  -m, --message=""                Box message
      --type="Info"               Info, Warning, Error, Hint
      --max-width=0               Max columns (0=TTY)
      --to-end-tty                Force full width
      --no-preffix                Hide icon

Style Flags:
  --border="rounded"          Border style: rounded, normal, double, thick, hidden
  --title.align="left"        Title alignment: left, center, right
  --title.transmit-color=""   Sync colors: "title to preffix" OR "preffix to title"
  --preffix.pad="0 0"         Prefix padding (Left Right)
  --foreground="0-255|#RRGGBB|R;G;B|name|none"   Text color
  --background="0-255|#RRGGBB|R;G;B|name|none"   Text background
  --border.foreground=""          Border color
  --title.foreground=""           Title color
  --title.background=""           Title background
  --preffix.foreground=""         Prefix icon color
  --preffix.background=""         Prefix icon background
  --bold, --italic,               Text decorations
  --underline, --strike

Colores aceptados en todas las flags de color:
  none / clear      (sin color, usa el color por defecto del tipo de caja)
  0-255             (256 colores ANSI)
  #RRGGBB / #RGB    (TrueColor hex, forma larga o corta)
  R;G;B             (TrueColor directo, ej: 255;100;0)
  Nombres básicos: black red green yellow blue magenta purple cyan white gray grey
           brightblack brightred brightgreen brightyellow brightblue
           brightmagenta brightpurple brightcyan brightwhite
  Nombres CSS: coral, mediumseagreen, cornflowerblue, rebeccapurple, etc.
               (lista completa con cualquier color inválido)
EOF
    }

    local title_raw=""
    local content=""
    local type="Info"
    local term_cols=$(tput cols 2>/dev/null || echo 80)
    local max_allowed_width=$term_cols 
    local no_prefix=false 
    local to_end_tty=false
    local border_style="rounded"
    local title_align="left"
    local preffix_pad="0 0"
    local transmit_direction="" 

    local user_fg="" user_bg="" user_border_fg="" user_title_fg="" user_title_bg=""
    local user_preffix_fg="" user_preffix_bg=""
    local text_modes=""
    local positional_args=()

    local __pre_args=()
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == --*=* ]]; then
            __pre_args+=("${1%%=*}" "${1#*=}")
        else
            __pre_args+=("$1")
        fi
        shift
    done
    set -- "${__pre_args[@]}"

    while [[ $# -gt 0 ]]; do
      local __argc_before=$#

      case "$1" in 
        -h|--help) show_help; return 0 ;;
        
        -t|--title)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing argument for $1" >&2; return 1; }
            title_raw="$2"; shift 2 ;;
        
        --title.align)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing argument for $1" >&2; return 1; }
            _assert_literal "$2" "--title.align" "left" "center" "right" || return 1
            title_align="$2"; shift 2 ;;

        --title.transmit-color)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing argument for $1" >&2; return 1; }
            _assert_literal "$2" "--title.transmit-color" "title to preffix" "preffix to title" || return 1
            [[ "$2" == "title to preffix" ]] && transmit_direction="t2p" || transmit_direction="p2t"
            shift 2 ;;

        -m|--message)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing argument for $1" >&2; return 1; }
            content="$2"; shift 2 ;;
        
        -T|--type)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing argument for $1" >&2; return 1; }
            _assert_literal "$2" "--type" "Info" "Warning" "Error" "Hint" || return 1
            type="$2"; shift 2 ;;
        
        --max-width)
             [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing argument for $1" >&2; return 1; }
             [[ ! "$2" =~ ^[0-9]+$ ]] && { echo "Error: Invalid value for --max-width: '$2'. Expected integer >= 0." >&2; return 1; }
             max_allowed_width="$2"; shift 2 ;;
        
        --border)
             [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing argument for $1" >&2; return 1; }
             _assert_literal "$2" "--border" "rounded" "normal" "double" "thick" "hidden" || return 1
             border_style="$2"; shift 2 ;;

        --to-end-tty) to_end_tty=true; shift ;;
        --no-preffix) no_prefix=true; shift ;;
        
        --foreground)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing color for $1" >&2; return 1; }
            user_fg=$(get_style_seq "fg" "$2") || return 1
            shift 2 ;;
        
        --background)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing color for $1" >&2; return 1; }
            user_bg=$(get_style_seq "bg" "$2") || return 1
            shift 2 ;;
        
        --border.foreground)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing color for $1" >&2; return 1; }
            user_border_fg=$(get_style_seq "fg" "$2") || return 1
            shift 2 ;;
        
        --title.foreground)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing color for $1" >&2; return 1; }
            user_title_fg=$(get_style_seq "fg" "$2") || return 1
            shift 2 ;;

        --title.background)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing color for $1" >&2; return 1; }
            user_title_bg=$(get_style_seq "bg" "$2") || return 1
            shift 2 ;;

        --preffix.foreground)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing color for $1" >&2; return 1; }
            user_preffix_fg=$(get_style_seq "fg" "$2") || return 1
            shift 2 ;;
        
        --preffix.background)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing color for $1" >&2; return 1; }
            user_preffix_bg=$(get_style_seq "bg" "$2") || return 1
            shift 2 ;;
        
        --preffix.pad)
            [[ $# -lt 2 || "$2" == -* ]] && { echo "Error: Missing padding for $1" >&2; return 1; }
            preffix_pad="$2"; shift 2 ;;

        --bold) text_modes+=$(get_style_seq "mode" "bold"); shift ;;
        --italic) text_modes+=$(get_style_seq "mode" "italic"); shift ;;
        --underline) text_modes+=$(get_style_seq "mode" "underline"); shift ;;
        --strike) text_modes+=$(get_style_seq "mode" "strike"); shift ;;

        -*) echo "Error: Unknown flag '$1'" >&2; return 1 ;;
        *) positional_args+=("$1"); shift ;;
      esac 

      if [[ $# -ge $__argc_before ]]; then
          echo "Error interno: el parser de argumentos no avanzó (posible bucle infinito) en '$1'." >&2
          return 1
      fi
    done 


    local pad_l=0 pad_r=0
    if [[ "$preffix_pad" =~ ^[0-9]+[[:space:]]+[0-9]+$ ]]; then
        read -r pad_l pad_r <<< "$preffix_pad"
    elif [[ "$preffix_pad" =~ ^[0-9]+$ ]]; then
        pad_l="$preffix_pad"; pad_r=0
    else
        echo "Error: Invalid value for --preffix.pad: '$preffix_pad' (Expected 'N N')" >&2; return 1
    fi

    if [[ -n "$transmit_direction" ]]; then
        if [[ "$transmit_direction" == "t2p" ]]; then
            user_preffix_fg="$user_title_fg"
            user_preffix_bg="$user_title_bg"
        elif [[ "$transmit_direction" == "p2t" ]]; then
            user_title_fg="$user_preffix_fg"
            user_title_bg="$user_preffix_bg"
        fi
    fi

    if [[ "$title_raw" =~ ^[[:space:]]*$ ]]; then title_raw=""; fi

    local pos_count=${#positional_args[@]}
    if [[ $pos_count -gt 0 ]]; then
        if [[ $pos_count -eq 1 ]]; then
            [[ -z "$content" ]] && content="${positional_args[0]}"
        elif [[ $pos_count -eq 2 ]]; then
            [[ -z "$title_raw" ]] && title_raw="${positional_args[0]}"
            [[ -z "$content" ]] && content="${positional_args[1]}"
        fi
    fi
    [[ -z "$content" ]] && content="Message"

    local b_tl="╭" b_tr="╮" b_bl="╰" b_br="╯" b_h="─" b_v="│"
    case "$border_style" in
        normal) b_tl="┌"; b_tr="┐"; b_bl="└"; b_br="┘"; b_h="─"; b_v="│" ;;
        double) b_tl="╔"; b_tr="╗"; b_bl="╚"; b_br="╝"; b_h="═"; b_v="║" ;;
        thick)  b_tl="┏"; b_tr="┓"; b_bl="┗"; b_br="┛"; b_h="━"; b_v="┃" ;;
        hidden) b_tl=" "; b_tr=" "; b_bl=" "; b_br=" "; b_h=" "; b_v=" " ;;
    esac

    local preffix_icon="󰋼 " default_color=$'\033[32m'
    case "${type}" in 
      Info) preffix_icon="󰋼 "; default_color=$'\033[32m';;
      Error) preffix_icon=" "; default_color=$'\033[31m';;
      Warning) preffix_icon=" "; default_color=$'\033[33m';;
      Hint) preffix_icon="󰛩 "; default_color=$'\033[35m';; 
    esac 
    [[ "${no_prefix}" == true ]] && preffix_icon=""

    local border_c="${user_border_fg:-$default_color}"
    local title_c="${user_title_fg:-$border_c}${user_title_bg}"
    local text_style="${text_modes}${user_fg}${user_bg}"
    local reset=$'\033[0m'
    
    local title=""
    local v_title_width=0
    
    if [[ -n "$title_raw" ]]; then
        local full_preffix=""
        if [[ -n "$preffix_icon" ]]; then
            local str_pad_l=$(printf "%*s" "$pad_l" "")
            local str_pad_r=$(printf "%*s" "$pad_r" "")
            
            local p_color="${user_preffix_fg}${user_preffix_bg}"
            if [[ -z "$p_color" ]]; then p_color="${title_c}"; fi
            
            if [[ -n "${user_preffix_fg}${user_preffix_bg}" ]]; then
                full_preffix="${str_pad_l}${p_color}${preffix_icon}${reset}${title_c}${str_pad_r}"
            else
                full_preffix="${str_pad_l}${preffix_icon}${str_pad_r}"
            fi
            
            local measure_str="${str_pad_l}${preffix_icon}${str_pad_r}${title_raw}"
            v_title_width=$(visible_width "$measure_str")
        else
            v_title_width=$(visible_width "$title_raw")
        fi
        
        title="${title_c}${full_preffix}${title_raw}${reset}"
    fi

    [[ "$max_allowed_width" -le 0 || "$max_allowed_width" -gt "$term_cols" ]] && max_allowed_width=$term_cols
    local inner_width_limit=$((max_allowed_width - 2))
    [[ $inner_width_limit -lt 1 ]] && inner_width_limit=1
    content=$(ansi_aware_wrap "$content" "$inner_width_limit")

    IFS=$'\n' read -rd '' -a lines <<< "$content"
    local calc_width=0
    for l in "${lines[@]}"; do
        local s_len=$(visible_width "$l")
        (( s_len > calc_width )) && calc_width=$s_len
    done

    local snap_tol=15
    ([[ "$to_end_tty" == true ]] || (( calc_width >= (inner_width_limit - snap_tol) ))) && calc_width=$inner_width_limit
    
    (( v_title_width > calc_width )) && calc_width=$v_title_width
    [[ $calc_width -gt $inner_width_limit ]] && calc_width=$inner_width_limit

    if [[ -n "$title" ]]; then
        printf '%s' "${border_c}${b_tl}${reset}"
        
        local total_h_space=$calc_width
        local filler_len=$((total_h_space - v_title_width))
        if [[ $filler_len -lt 0 ]]; then filler_len=0; fi

        case "$title_align" in
            left)
                printf '%s' "${title}${border_c}"
                for ((i=0; i<filler_len; i++)); do printf '%s' "$b_h"; done
                ;;
            right)
                printf '%s' "${border_c}"
                for ((i=0; i<filler_len; i++)); do printf '%s' "$b_h"; done
                printf '%s' "${reset}${title}"
                ;;
            center)
                local left_fill=$((filler_len / 2))
                local right_fill=$((filler_len - left_fill))
                printf '%s' "${border_c}"
                for ((i=0; i<left_fill; i++)); do printf '%s' "$b_h"; done
                printf '%s' "${reset}${title}${border_c}"
                for ((i=0; i<right_fill; i++)); do printf '%s' "$b_h"; done
                ;;
        esac
        printf '%s\n' "${border_c}${b_tr}${reset}"
    else
        printf '%s' "${border_c}${b_tl}"
        for ((i=0; i<calc_width; i++)); do printf '%s' "$b_h"; done
        printf '%s\n' "${b_tr}${reset}"
    fi

    for line in "${lines[@]}"; do
        local len=$(visible_width "$line")
        printf '%s%s%s%s%s%s%*s%s%s%s\n' \
            "$border_c" "$b_v" "$reset" "$text_style" "$line" "$reset" \
            $((calc_width - len)) "" \
            "$border_c" "$b_v" "$reset"
    done

    printf '%s' "${border_c}${b_bl}"
    for ((i=0; i<calc_width; i++)); do printf '%s' "$b_h"; done
    printf '%s\n' "${b_br}${reset}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    messagebox "${@}"
fi
