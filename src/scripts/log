#!/usr/bin/env bash

function cmd_log() {

    local ESC=$'\e'

    function die() {
        printf '%s\n' "${ESC}[31m[!] Error: $1${ESC}[0m" >&2
        exit 1
    }

    local _CSS_COLORS_INIT=0
    function _css_init() {
        [[ $_CSS_COLORS_INIT -eq 1 ]] && return
        declare -gA _CSS_COLORS=(
            [aliceblue]=f0f8ff [antiquewhite]=faebd7 [aqua]=00ffff [aquamarine]=7fffd4
            [azure]=f0ffff [beige]=f5f5dc [bisque]=ffe4c4 [black]=000000
            [blanchedalmond]=ffebcd [blue]=0000ff [blueviolet]=8a2be2 [brown]=a52a2a
            [burlywood]=deb887 [cadetblue]=5f9ea0 [chartreuse]=7fff00 [chocolate]=d2691e
            [coral]=ff7f50 [cornflowerblue]=6495ed [cornsilk]=fff8dc [crimson]=dc143c
            [cyan]=00ffff [darkblue]=00008b [darkcyan]=008b8b [darkgoldenrod]=b8860b
            [darkgray]=a9a9a9 [darkgreen]=006400 [darkgrey]=a9a9a9 [darkkhaki]=bdb76b
            [darkmagenta]=8b008b [darkolivegreen]=556b2f [darkorange]=ff8c00 [darkorchid]=9932cc
            [darkred]=8b0000 [darksalmon]=e9967a [darkseagreen]=8fbc8f [darkslateblue]=483d8b
            [darkslategray]=2f4f4f [darkslategrey]=2f4f4f [darkturquoise]=00ced1 [darkviolet]=9400d3
            [deeppink]=ff1493 [deepskyblue]=00bfff [dimgray]=696969 [dimgrey]=696969
            [dodgerblue]=1e90ff [firebrick]=b22222 [floralwhite]=fffaf0 [forestgreen]=228b22
            [fuchsia]=ff00ff [gainsboro]=dcdcdc [ghostwhite]=f8f8ff [gold]=ffd700
            [goldenrod]=daa520 [gray]=808080 [green]=008000 [greenyellow]=adff2f
            [grey]=808080 [honeydew]=f0fff0 [hotpink]=ff69b4 [indianred]=cd5c5c
            [indigo]=4b0082 [ivory]=fffff0 [khaki]=f0e68c [lavender]=e6e6fa
            [lavenderblush]=fff0f5 [lawngreen]=7cfc00 [lemonchiffon]=fffacd [lightblue]=add8e6
            [lightcoral]=f08080 [lightcyan]=e0ffff [lightgoldenrodyellow]=fafad2 [lightgray]=d3d3d3
            [lightgreen]=90ee90 [lightgrey]=d3d3d3 [lightpink]=ffb6c1 [lightsalmon]=ffa07a
            [lightseagreen]=20b2aa [lightskyblue]=87cefa [lightslategray]=778899 [lightslategrey]=778899
            [lightsteelblue]=b0c4de [lightyellow]=ffffe0 [lime]=00ff00 [limegreen]=32cd32
            [linen]=faf0e6 [magenta]=ff00ff [maroon]=800000 [mediumaquamarine]=66cdaa
            [mediumblue]=0000cd [mediumorchid]=ba55d3 [mediumpurple]=9370db [mediumseagreen]=3cb371
            [mediumslateblue]=7b68ee [mediumspringgreen]=00fa9a [mediumturquoise]=48d1cc [mediumvioletred]=c71585
            [midnightblue]=191970 [mintcream]=f5fffa [mistyrose]=ffe4e1 [moccasin]=ffe4b5
            [navajowhite]=ffdead [navy]=000080 [oldlace]=fdf5e6 [olive]=808000
            [olivedrab]=6b8e23 [orange]=ffa500 [orangered]=ff4500 [orchid]=da70d6
            [palegoldenrod]=eee8aa [palegreen]=98fb98 [paleturquoise]=afeeee [palevioletred]=db7093
            [papayawhip]=ffefd5 [peachpuff]=ffdab9 [peru]=cd853f [pink]=ffc0cb
            [plum]=dda0dd [powderblue]=b0e0e6 [purple]=800080 [rebeccapurple]=663399
            [red]=ff0000 [rosybrown]=bc8f8f [royalblue]=4169e1 [saddlebrown]=8b4513
            [salmon]=fa8072 [sandybrown]=f4a460 [seagreen]=2e8b57 [seashell]=fff5ee
            [sienna]=a0522d [silver]=c0c0c0 [skyblue]=87ceeb [slateblue]=6a5acd
            [slategray]=708090 [slategrey]=708090 [snow]=fffafa [springgreen]=00ff7f
            [steelblue]=4682b4 [tan]=d2b48c [teal]=008080 [thistle]=d8bfd8
            [tomato]=ff6347 [turquoise]=40e0d0 [violet]=ee82ee [wheat]=f5deb3
            [white]=ffffff [whitesmoke]=f5f5f5 [yellow]=ffff00 [yellowgreen]=9acd32
        )
        _CSS_COLORS_INIT=1
    }

    function is_valid_color() {
        local val="${1,,}"
        [[ "$val" =~ ^#([a-fA-F0-9]{6}|[a-fA-F0-9]{3})$ ]] && return 0
        [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 0 && val <= 255 )) && return 0
        case "$val" in
            black|red|green|yellow|blue|magenta|purple|cyan|white|gray|grey) return 0 ;;
            brightblack|brightred|brightgreen|brightyellow|brightblue|brightmagenta|brightpurple|brightcyan|brightwhite) return 0 ;;
        esac
        _css_init
        [[ -n "${_CSS_COLORS[$val]:-}" ]] && return 0
        return 1
    }

    function _list_color_names() {
        _css_init
        local names=(
            black red green yellow blue magenta purple cyan white gray grey
            brightblack brightred brightgreen brightyellow brightblue
            brightmagenta brightpurple brightcyan brightwhite
        )
        names+=("${!_CSS_COLORS[@]}")
        printf '%s\n' "${names[@]}" | sort -u | paste -sd, - | sed 's/,/, /g'
    }

    function resolve_color() {
        local val="${1,,}"
        [[ -z "$val" ]] && return
        if [[ "$val" == \#* ]]; then
            echo "$val"; return
        fi
        case "$val" in
            black) echo "0" ;; red) echo "1" ;; green) echo "2" ;; yellow) echo "3" ;; blue) echo "4" ;;
            magenta|purple) echo "5" ;; cyan) echo "6" ;; white) echo "7" ;;
            brightblack|gray|grey) echo "8" ;; brightred) echo "9" ;; brightgreen) echo "10" ;;
            brightyellow) echo "11" ;; brightblue) echo "12" ;; brightmagenta|brightpurple) echo "13" ;;
            brightcyan) echo "14" ;;
            brightwhite) echo "15" ;;
            *)
                if [[ "$val" =~ ^[0-9]+$ ]]; then
                    echo "$val"
                else
                    _css_init
                    local hex="${_CSS_COLORS[$val]:-}"
                    if [[ -n "$hex" ]]; then
                        echo "#$hex"
                    else
                        echo "$val"
                    fi
                fi
                ;;
        esac
    }

    function _color_seq() {
        local val="$1" layer="$2"
        [[ -z "$val" ]] && return
        if [[ "$val" == \#* ]]; then
            local hex="${val#\#}"
            [[ ${#hex} -eq 3 ]] && hex="${hex:0:1}${hex:0:1}${hex:1:1}${hex:1:1}${hex:2:1}${hex:2:1}"
            local r=$(( 16#${hex:0:2} )); local g=$(( 16#${hex:2:2} )); local b=$(( 16#${hex:4:2} ))
            printf "${ESC}[%d;2;%d;%d;%dm" "$layer" "$r" "$g" "$b"
        else
            printf "${ESC}[%d;5;%dm" "$layer" "$val"
        fi
    }

    function get_style_seq() {
        local type="$1" code="$2"
        [[ -z "$code" ]] && return
        local layer=38
        [[ "$type" == "bg" ]] && layer=48
        local resolved
        resolved="$(resolve_color "$code")"
        _color_seq "$resolved" "$layer"
    }


    function strip_ansi() {
        local input
        if [[ $# -gt 0 ]]; then
            input="$*"
        else
            IFS= read -r -d '' input
        fi

        local out=""
        local -i state=0 inCSI 3=startOSC 4=inOSC 5=ignoreNext
        local -r ESC=$'\x1b'
        local -r BEL=$'\x07'
        local -i i len=${#input}
        local c

        for (( i=0; i<len; i++ )); do
            c="${input:i:1}"
            case "$state" in
                0) 
                    case "$c" in
                        "$ESC") state=1 ;;
                        "$BEL") : ;;
                        *) out+="$c" ;;
                    esac
                    ;;
                1)
                    case "$c" in
                        '[') state=2 ;;
                        ']') state=3 ;;
                        '%'|'('|')'|'0'|'3'|'5'|'6'|'#') state=5 ;;
                        "$BEL"|'A'|'B'|'C'|'D'|'E'|'H'|'I'|'J'|'K'|'M'|'N'|'O'|'S'|'T'|'Z'|'c'|'s'|'u'|'1'|'2'|'7'|'8'|'<'|'='|'>')
                            state=0 ;;
                        *)
                            out+="${ESC}${c}"
                            state=0
                            ;;
                    esac
                    ;;
                2) 
                    case "$c" in
                        ';'|'?'|[0-9]) : ;;
                        *) state=0 ;;
                    esac
                    ;;
                3) 
                    case "$c" in
                        [0-9]) state=4 ;;
                        *) state=0 ;;
                    esac
                    ;;
                4) 
                    case "$c" in
                        "$BEL") state=0 ;;
                        "$ESC") state=5 ;;
                    esac
                    ;;
                5) 
                    state=0
                    ;;
            esac
        done

        printf '%s' "$out"
    }

    function show_help_panel() {
        cat <<EOF
Usage: bash-utils log <text> ... [flags]

Log messages to output

Arguments:
  <text> ...      Text to log. El primer argumento es el mensaje; los
                  siguientes se emparejan de a dos como key value (sin
                  necesidad de escribir 'key=value'), igual que gum.

Flags:
  -h, --help              Show help.
  -o, --file=STRING       Log to file
  -f, --format            Format message using printf (los args restantes
                          se usan como parámetros de printf, no como pares
                          key/value)
      --formatter="text"  The log formatter to use (text, json)
  -l, --level="none"      The log level to use (debug, info, warn, error, fatal, none)
      --prefix=STRING      Prefix to print before the message
  -s, --structured        Use structured logging (no cambia el formatter;
                          solo es mutuamente excluyente con --format. Para
                          salida JSON usá --formatter=json explícitamente)
  -t, --time=""           The time format to use (kitchen, layout, ansic, rfc822, etc...)
      --min-level=""      Minimal level to show

Style Flags (Colors accept a name (incl. CSS names like 'coral'), #HEX, or 0-255):
  --level.foreground=""          Foreground Color 
  --level.background=""          Background Color 
  --time.foreground=""           Foreground Color
  --time.background=""           Background Color 
  --prefix.foreground=""         Foreground Color 
  --prefix.background=""         Background Color 
  --message.foreground=""        Foreground Color 
  --message.background=""        Background Color 
  --key.foreground=""            Foreground Color 
  --key.background=""            Background Color 
  --value.foreground=""          Foreground Color 
  --value.background=""          Background Color 
  --separator.foreground=""      Foreground Color 
  --separator.background=""      Background Color 
EOF
    }

    local log_level="none"
    local min_level=""
    local output_file=""
    local prefix=""
    local formatter="text"
    local time_format=""
    local format_msg=false
    local structured_flag=false

    declare -A DEFAULT_LEVEL_FG=( ["debug"]="cyan" ["info"]="green" ["warn"]="yellow" ["error"]="red" ["fatal"]="magenta" )

    local s_lvl_fg="" s_lvl_bg=""
    local s_time_fg="" s_time_bg=""
    local s_pre_fg="" s_pre_bg=""
    local s_msg_fg="" s_msg_bg=""
    local s_key_fg="" s_key_bg=""
    local s_val_fg="" s_val_bg=""
    local s_sep_fg="" s_sep_bg=""

    local DEFAULT_FAINT="${ESC}[2m"
    local DEFAULT_PREFIX_STYLE="${ESC}[1;2m"

    local args_text=()

    while [[ $# -gt 0 ]]; do
        local key="$1"
        local base_key="$key"
        local val="" has_val=false

        if [[ "$key" == --*=* ]]; then
            base_key="${key%%=*}"; val="${key#*=}"; has_val=true
        elif [[ "$key" == -[a-zA-Z]=* ]]; then
            base_key="${key:0:2}"; val="${key:3}"; has_val=true
        fi

        case "$base_key" in
            -h|--help)
                $has_val && die "'${base_key}' no acepta un valor. Literal esperado: la bandera sola, sin '='."
                show_help_panel; return 0
                ;;

            -f|--format)
                $has_val && die "'${base_key}' no acepta un valor. Literal esperado: la bandera sola, sin '='."
                $structured_flag && die "'--format' y '--structured' son mutuamente excluyentes."
                format_msg=true; shift
                ;;

            -s|--structured)
                $has_val && die "'${base_key}' no acepta un valor. Literal esperado: la bandera sola, sin '='."
                $format_msg && die "'--structured' y '--format' son mutuamente excluyentes."
                structured_flag=true; shift
                ;;

            -o|--file|--prefix|-t|--time)
                local flagval
                if $has_val; then
                    flagval="$val"; shift
                else
                    shift
                    if [[ $# -lt 1 || "$1" == --* ]]; then
                        die "Falta argumento para '${base_key}'. Literal esperado: un valor (ni otra bandera)."
                    fi
                    flagval="$1"; shift
                fi
                case "$base_key" in
                    -o|--file)  output_file="$flagval" ;;
                    --prefix)   prefix="$flagval" ;;
                    -t|--time)  time_format="$flagval" ;;
                esac
                ;;

            --formatter|-l|--level|--min-level)
                local flagval
                if $has_val; then
                    flagval="$val"; shift
                else
                    shift
                    if [[ $# -lt 1 || "$1" == --* ]]; then
                        die "Falta argumento para '${base_key}'. Literal esperado: un valor (ni otra bandera)."
                    fi
                    flagval="$1"; shift
                fi
                case "$base_key" in
                    --formatter)
                        [[ "${flagval,,}" =~ ^(text|json)$ ]] || die "Valor inválido para '--formatter': '${flagval}'. Literales esperados: text, json."
                        formatter="${flagval,,}"
                        ;;
                    -l|--level)
                        [[ "${flagval,,}" =~ ^(debug|info|warn|error|fatal|none)$ ]] || die "Valor inválido para '--level': '${flagval}'. Literales esperados: debug, info, warn, error, fatal, none."
                        log_level="${flagval,,}"
                        ;;
                    --min-level)
                        [[ "${flagval,,}" =~ ^(debug|info|warn|error|fatal|none)$ ]] || die "Valor inválido para '--min-level': '${flagval}'. Literales esperados: debug, info, warn, error, fatal, none."
                        min_level="${flagval,,}"
                        ;;
                esac
                ;;

            --level.foreground|--level.background|--time.foreground|--time.background|\
            --prefix.foreground|--prefix.background|--message.foreground|--message.background|\
            --key.foreground|--key.background|--value.foreground|--value.background|\
            --separator.foreground|--separator.background)
                local flagval
                if $has_val; then
                    flagval="$val"; shift
                else
                    shift
                    if [[ $# -lt 1 || "$1" == --* ]]; then
                        die "Falta argumento para '${base_key}'. Literal esperado: un valor de color (ni otra bandera)."
                    fi
                    flagval="$1"; shift
                fi

                is_valid_color "$flagval" || die "color '${flagval}' no encontrado, colores disponibles: $(_list_color_names)"

                case "$base_key" in
                    --level.foreground)     s_lvl_fg=$(get_style_seq "fg" "$flagval") ;;
                    --level.background)     s_lvl_bg=$(get_style_seq "bg" "$flagval") ;;
                    --time.foreground)      s_time_fg=$(get_style_seq "fg" "$flagval") ;;
                    --time.background)      s_time_bg=$(get_style_seq "bg" "$flagval") ;;
                    --prefix.foreground)    s_pre_fg=$(get_style_seq "fg" "$flagval") ;;
                    --prefix.background)    s_pre_bg=$(get_style_seq "bg" "$flagval") ;;
                    --message.foreground)   s_msg_fg=$(get_style_seq "fg" "$flagval") ;;
                    --message.background)   s_msg_bg=$(get_style_seq "bg" "$flagval") ;;
                    --key.foreground)       s_key_fg=$(get_style_seq "fg" "$flagval") ;;
                    --key.background)       s_key_bg=$(get_style_seq "bg" "$flagval") ;;
                    --value.foreground)     s_val_fg=$(get_style_seq "fg" "$flagval") ;;
                    --value.background)     s_val_bg=$(get_style_seq "bg" "$flagval") ;;
                    --separator.foreground) s_sep_fg=$(get_style_seq "fg" "$flagval") ;;
                    --separator.background) s_sep_bg=$(get_style_seq "bg" "$flagval") ;;
                esac
                ;;

            -*)
                die "Bandera desconocida: '${base_key}'."
                ;;

            *)
                args_text+=("$1")
                shift
                ;;
        esac
    done

    if [[ ${#args_text[@]} -eq 0 ]]; then
        show_help_panel >&2
        printf '\n%s\n' "gum: error: expected \"<text> ...\"" >&2
        return 1
    fi

    declare -A LEVEL_VAL=( ["none"]=0 ["debug"]=1 ["info"]=2 ["warn"]=3 ["error"]=4 ["fatal"]=5 )
    if [[ -n "$min_level" ]]; then
        local current_val=${LEVEL_VAL[$log_level]:-0}
        local min_val=${LEVEL_VAL[$min_level]:-0}
        if (( current_val < min_val )); then return 0; fi
    fi

    local message="${args_text[0]}"
    local kv_keys=() kv_vals=()

    if [[ "$format_msg" == "true" ]]; then
        local fmt="${args_text[0]}"
        local params=("${args_text[@]:1}")
        message=$(printf "$fmt" "${params[@]}" 2>/dev/null) || message="${args_text[*]}"
    else
        local extra=("${args_text[@]:1}")
        local n=${#extra[@]}
        local i=0
        while (( i < n )); do
            kv_keys+=("${extra[i]}")
            kv_vals+=("${extra[i+1]:-}")
            (( i += 2 ))
        done
    fi

    local timestamp=""
    if [[ -n "$time_format" ]]; then
        local fmt=""
        case "$time_format" in
            kitchen)  fmt="%I:%M%p" ;;
            layout)   fmt="%m/%d/%y %I:%M%p" ;;
            ansic)    fmt="%a %b %e %H:%M:%S %Y" ;;
            rfc822)   fmt="%a, %d %b %y %H:%M %Z" ;;
            datetime) fmt="%Y-%m-%d %H:%M:%S" ;;
            *)        fmt="$time_format" ;;
        esac
        timestamp=$(date +"$fmt")
    fi

    if [[ "$formatter" == "json" ]]; then
        local ts_iso=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        local msg_esc="${message//\"/\\\"}"
        local json_parts=()
        json_parts+=("\"time\":\"$ts_iso\"")
        json_parts+=("\"level\":\"${log_level^^}\"")
        [[ -n "$prefix" ]] && json_parts+=("\"prefix\":\"$prefix\"")
        json_parts+=("\"message\":\"$msg_esc\"")
        local j=0
        for j in "${!kv_keys[@]}"; do
            local k="${kv_keys[$j]}"
            local v="${kv_vals[$j]}"
            v="${v//\"/\\\"}"
            json_parts+=("\"$k\":\"$v\"")
        done
        local final_output="{$(IFS=,; echo "${json_parts[*]}")}"
        echo "$final_output" >&2
        [[ -n "$output_file" ]] && echo "$final_output" >> "$output_file"
        return 0
    fi

    local reset="\033[0m"
    local output_line=""

    if [[ -n "$timestamp" ]]; then
        local t_style="${s_time_fg}${s_time_bg}"
        output_line+="${t_style}${timestamp}${reset} "
    fi

    if [[ "$log_level" != "none" ]]; then
        local lvl_str="${log_level^^}"
        local l_color="${ESC}[1m"
        if [[ -n "$s_lvl_fg" ]]; then
            l_color+="$s_lvl_fg"
        else
            local def_col="${DEFAULT_LEVEL_FG[$log_level]}"
            l_color+="$(get_style_seq "fg" "$def_col")"
        fi
        output_line+="${l_color}${s_lvl_bg}${lvl_str}${reset} "
    fi

    if [[ -n "$prefix" ]]; then
        local p_style
        if [[ -n "$s_pre_fg" || -n "$s_pre_bg" ]]; then
            p_style="${s_pre_fg}${s_pre_bg}"
        else
            p_style="$DEFAULT_PREFIX_STYLE"
        fi
        output_line+="${p_style}${prefix}${reset} "
    fi

    local m_style="${s_msg_fg}${s_msg_bg}"
    output_line+="${m_style}${message}${reset}"

    if [[ ${#kv_keys[@]} -gt 0 ]]; then
        local k_style="${s_key_fg:-$DEFAULT_FAINT}${s_key_bg}"
        local v_style="${s_val_fg}${s_val_bg}"
        local sep_style="${s_sep_fg:-$DEFAULT_FAINT}${s_sep_bg}"
        local idx=0
        for idx in "${!kv_keys[@]}"; do
            output_line+=" ${k_style}${kv_keys[$idx]}${reset}${sep_style}=${reset}${v_style}${kv_vals[$idx]}${reset}"
        done
    fi

    printf "%b\n" "$output_line" >&2

    if [[ -n "$output_file" ]]; then
        local clean_output
        clean_output=$(strip_ansi "$output_line")
        printf "%s\n" "$clean_output" >> "$output_file"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    cmd_log "${@}"
fi
