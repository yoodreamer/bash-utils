#!/usr/bin/env bash

function cmd_spin() {
    local ESC=$'\e'
    local CR=$'\r'
    local NL=$'\n'

    function die() {
        printf '%s\n' "${ESC}[31m[!] Error: $1${ESC}[0m" >&2
        exit 1
    }

    local VALID_SPINNERS=("dot" "line" "minidot" "jump" "pulse" "points" "globe" "moon" "monkey" "meter" "hamburger" "standard" "bar" "process")

    local _CSS_COLORS_INIT=0
    function _css_init() {
        [[ $_CSS_COLORS_INIT -eq 1 ]] && return
        declare -gA _CSS_COLORS=(
            [aliceblue]=f0f8ff [antiquewhite]=faebd7 [aqua]=00ffff [aquamarine]=7fffd4
            [azure]=f0ffff [beige]=f5f5dc [bisque]=ffe4c4 [black]=000000
            [blanchedalmond]=ffebcd [blue]=0000ff [blueviolet]=8a2be2 [brown]=a52a2a
            [burlywood]=deb887 [cadetblue]=5f9ea0 [chartreuse]=7fff00 [chocolate]=d2691e
            [coral]=ff7f50 [cornflowerblue]=6495ed [cornsilk]=fff8dc [crimson]=dc143c
            [cyan]=00ffff [darkblue]=00008b [darkcyan]=008b8b [darkgoldenrod]=b8860b
            [darkgray]=a9a9a9 [darkgreen]=006400 [darkgrey]=a9a9a9 [darkkhaki]=bdb76b
            [darkmagenta]=8b008b [darkolivegreen]=556b2f [darkorange]=ff8c00 [darkorchid]=9932cc
            [darkred]=8b0000 [darksalmon]=e9967a [darkseagreen]=8fbc8f [darkslateblue]=483d8b
            [darkslategray]=2f4f4f [darkslategrey]=2f4f4f [darkturquoise]=00ced1 [darkviolet]=9400d3
            [deeppink]=ff1493 [deepskyblue]=00bfff [dimgray]=696969 [dimgrey]=696969
            [dodgerblue]=1e90ff [firebrick]=b22222 [floralwhite]=fffaf0 [forestgreen]=228b22
            [fuchsia]=ff00ff [gainsboro]=dcdcdc [ghostwhite]=f8f8ff [gold]=ffd700
            [goldenrod]=daa520 [gray]=808080 [green]=008000 [greenyellow]=adff2f
            [grey]=808080 [honeydew]=f0fff0 [hotpink]=ff69b4 [indianred]=cd5c5c
            [indigo]=4b0082 [ivory]=fffff0 [khaki]=f0e68c [lavender]=e6e6fa
            [lavenderblush]=fff0f5 [lawngreen]=7cfc00 [lemonchiffon]=fffacd [lightblue]=add8e6
            [lightcoral]=f08080 [lightcyan]=e0ffff [lightgoldenrodyellow]=fafad2 [lightgray]=d3d3d3
            [lightgreen]=90ee90 [lightgrey]=d3d3d3 [lightpink]=ffb6c1 [lightsalmon]=ffa07a
            [lightseagreen]=20b2aa [lightskyblue]=87cefa [lightslategray]=778899 [lightslategrey]=778899
            [lightsteelblue]=b0c4de [lightyellow]=ffffe0 [lime]=00ff00 [limegreen]=32cd32
            [linen]=faf0e6 [magenta]=ff00ff [maroon]=800000 [mediumaquamarine]=66cdaa
            [mediumblue]=0000cd [mediumorchid]=ba55d3 [mediumpurple]=9370db [mediumseagreen]=3cb371
            [mediumslateblue]=7b68ee [mediumspringgreen]=00fa9a [mediumturquoise]=48d1cc [mediumvioletred]=c71585
            [midnightblue]=191970 [mintcream]=f5fffa [mistyrose]=ffe4e1 [moccasin]=ffe4b5
            [navajowhite]=ffdead [navy]=000080 [oldlace]=fdf5e6 [olive]=808000
            [olivedrab]=6b8e23 [orange]=ffa500 [orangered]=ff4500 [orchid]=da70d6
            [palegoldenrod]=eee8aa [palegreen]=98fb98 [paleturquoise]=afeeee [palevioletred]=db7093
            [papayawhip]=ffefd5 [peachpuff]=ffdab9 [peru]=cd853f [pink]=ffc0cb
            [plum]=dda0dd [powderblue]=b0e0e6 [purple]=800080 [rebeccapurple]=663399
            [red]=ff0000 [rosybrown]=bc8f8f [royalblue]=4169e1 [saddlebrown]=8b4513
            [salmon]=fa8072 [sandybrown]=f4a460 [seagreen]=2e8b57 [seashell]=fff5ee
            [sienna]=a0522d [silver]=c0c0c0 [skyblue]=87ceeb [slateblue]=6a5acd
            [slategray]=708090 [slategrey]=708090 [snow]=fffafa [springgreen]=00ff7f
            [steelblue]=4682b4 [tan]=d2b48c [teal]=008080 [thistle]=d8bfd8
            [tomato]=ff6347 [turquoise]=40e0d0 [violet]=ee82ee [wheat]=f5deb3
            [white]=ffffff [whitesmoke]=f5f5f5 [yellow]=ffff00 [yellowgreen]=9acd32
        )
        _CSS_COLORS_INIT=1
    }

    function is_valid_color() {
        local val="${1,,}"
        [[ -z "$val" || "$val" == "none" || "$val" == "clear" ]] && return 0
        [[ "$val" =~ ^#([a-fA-F0-9]{6}|[a-fA-F0-9]{3})$ ]] && return 0
        [[ "$val" =~ ^[0-9]+$ ]] && (( val >= 0 && val <= 255 )) && return 0
        case "$val" in
            black|red|green|yellow|blue|magenta|purple|cyan|white|gray|grey) return 0 ;;
            brightblack|brightred|brightgreen|brightyellow|brightblue|brightmagenta|brightpurple|brightcyan|brightwhite) return 0 ;;
        esac
        _css_init
        [[ -n "${_CSS_COLORS[$val]:-}" ]] && return 0
        return 1
    }

    function _list_color_names() {
        _css_init
        local names=(
            black red green yellow blue magenta purple cyan white gray grey
            brightblack brightred brightgreen brightyellow brightblue
            brightmagenta brightpurple brightcyan brightwhite
        )
        names+=("${!_CSS_COLORS[@]}")
        printf '%s\n' "${names[@]}" | sort -u | paste -sd, - | sed 's/,/, /g'
    }

    function _color_seq() {
        local val="${1,,}" layer="$2"
        [[ -z "$val" || "$val" == "none" || "$val" == "clear" ]] && return
        if [[ "$val" == \#* ]]; then
            local hex="${val#\#}"
            [[ ${#hex} -eq 3 ]] && hex="${hex:0:1}${hex:0:1}${hex:1:1}${hex:1:1}${hex:2:1}${hex:2:1}"
            local r=$(( 16#${hex:0:2} ))
            local g=$(( 16#${hex:2:2} ))
            local b=$(( 16#${hex:4:2} ))
            printf "${ESC}[%d;2;%d;%d;%dm" "$layer" "$r" "$g" "$b"
        elif [[ "$val" =~ ^[0-9]+$ ]]; then
            printf "${ESC}[%d;5;%dm" "$layer" "$val"
        else
            local base=0
            [[ "$layer" == 38 ]] && base=30
            [[ "$layer" == 48 ]] && base=40
            case "$val" in
                black)                 printf "${ESC}[%dm" $((base + 0)) ;;
                red)                   printf "${ESC}[%dm" $((base + 1)) ;;
                green)                 printf "${ESC}[%dm" $((base + 2)) ;;
                yellow)                printf "${ESC}[%dm" $((base + 3)) ;;
                blue)                  printf "${ESC}[%dm" $((base + 4)) ;;
                magenta|purple)        printf "${ESC}[%dm" $((base + 5)) ;;
                cyan)                  printf "${ESC}[%dm" $((base + 6)) ;;
                white)                 printf "${ESC}[%dm" $((base + 7)) ;;
                gray|grey|brightblack) printf "${ESC}[%dm" $((base + 60)) ;;
                brightred)             printf "${ESC}[%dm" $((base + 61)) ;;
                brightgreen)           printf "${ESC}[%dm" $((base + 62)) ;;
                brightyellow)          printf "${ESC}[%dm" $((base + 63)) ;;
                brightblue)            printf "${ESC}[%dm" $((base + 64)) ;;
                brightmagenta|brightpurple) printf "${ESC}[%dm" $((base + 65)) ;;
                brightcyan)            printf "${ESC}[%dm" $((base + 66)) ;;
                brightwhite)           printf "${ESC}[%dm" $((base + 67)) ;;
                *)
                    _css_init
                    local hex="${_CSS_COLORS[$val]:-}"
                    if [[ -n "$hex" ]]; then
                        local r=$(( 16#${hex:0:2} ))
                        local g=$(( 16#${hex:2:2} ))
                        local b=$(( 16#${hex:4:2} ))
                        printf "${ESC}[%d;2;%d;%d;%dm" "$layer" "$r" "$g" "$b"
                    fi
                    ;;
            esac
        fi
    }

    function make_ansi() {
        local fg="$1" bg="$2"
        _color_seq "$fg" 38
        _color_seq "$bg" 48
    }

    local spinner_type="dot"
    local title="Loading..."
    local align="left"
    local timeout=0
    local spin_delay=""

    local show_output=false
    local show_error=false
    local show_stdout=false
    local show_stderr=false

    local c_spinner_fg="212"
    local c_spinner_bg=""
    local c_title_fg=""
    local c_title_bg=""
    local t_padding="0 0 0 0"

    local live_output=false
    local lo_fg=""
    local lo_bg=""
    local lo_padding="0 0 0 0"
    local lo_max_lines=8

    function show_help_panel() {
        cat <<EOF
Usage: bash-utils spin [flags] -- <command> ...

Display spinner while running a command. Keyboards are safely restricted.

Flags:
  -h, --help                Show this help
      --show-output         Show output (STDOUT+STDERR) after finish
      --show-error          Show output only if command fails
      --show-stdout         Show STDOUT after finish
      --show-stderr         Show STDERR after finish
  -s, --spinner="dot"       Spinner type:
                            dot line minidot jump pulse points globe
                            moon monkey meter hamburger standard bar process
      --title="Loading..."  Text shown next to spinner
  -a, --align="left"        Alignment: left | right
      --timeout=0           Timeout in seconds (0 = no timeout)
      --spin-delay=""       Custom frame delay (e.g. 0.1)

Style Flags (Accepts Names (incl. CSS names like 'coral'), 0-255, #HEX):
      --spinner.foreground  Spinner color
      --spinner.background  Spinner background
      --title.foreground    Title color
      --title.background    Title background
      --title.padding       Padding CSS (top right bottom left)

Live Output Flags:
      --live-output                 Shows output in real time
      --live-output.foreground=""   Text color
      --live-output.background=""   Background color
      --live-output.padding="0 0 0" Padding CSS (top right bottom left)
      --live-output.max-lines=8     Maximum output lines shown
EOF
    }

    local args_flags=()
    local user_cmd=()
    local found_dash=false

    for arg in "$@"; do
        if [[ "$found_dash" == "true" ]]; then
            user_cmd+=("$arg")
        elif [[ "$arg" == "--" ]]; then
            found_dash=true
        else
            args_flags+=("$arg")
        fi
    done

    set -- "${args_flags[@]}"

    local -A _known_flags=(
        [-h]=1 [--help]=1
        [--show-output]=1 [--show-error]=1 [--show-stdout]=1 [--show-stderr]=1 [--live-output]=1
        [-s]=1 [--spinner]=1 [--title]=1 [-a]=1 [--align]=1 [--timeout]=1 [--spin-delay]=1
        [--spinner.foreground]=1 [--spinner.background]=1
        [--title.foreground]=1 [--title.background]=1 [--title.padding]=1
        [--live-output.foreground]=1 [--live-output.background]=1
        [--live-output.padding]=1 [--live-output.max-lines]=1
    )

    while [[ $# -gt 0 ]]; do
        local arg="$1"
        local base_key="$arg"
        [[ "$arg" == *=* ]] && base_key="${arg%%=*}"

        if [[ -z "${_known_flags[$base_key]:-}" ]]; then
            die "Bandera desconocida: '${base_key}'. Usa '--help'."
        fi

        local is_boolean=false
        case "$base_key" in
            -h|--help|--show-output|--show-error|--show-stdout|--show-stderr|--live-output)
                is_boolean=true ;;
        esac

        local val=""
        if [[ "$is_boolean" == "true" ]]; then
            if [[ "$arg" == *=* ]]; then
                die "La bandera '${base_key}' no acepta valores asignados."
            fi
            shift
        else
            if [[ "$arg" == *=* ]]; then
                val="${arg#*=}"
                shift
            else
                shift
                if [[ $# -lt 1 || "$1" == --* ]]; then
                    if [[ "$base_key" == "--title" ]]; then
                        val="" 
                    else
                        die "Falta argumento para '${base_key}'."
                    fi
                else
                    val="$1"
                    shift
                fi
            fi
        fi

        case "$base_key" in
            -h|--help)                  show_help_panel; return 0 ;;
            --show-output)              show_output=true ;;
            --show-error)               show_error=true ;;
            --show-stdout)              show_stdout=true ;;
            --show-stderr)              show_stderr=true ;;
            --live-output)              live_output=true ;;

            -s|--spinner)
                local is_valid=false
                for v in "${VALID_SPINNERS[@]}"; do
                    [[ "$v" == "$val" ]] && { is_valid=true; break; }
                done
                if [[ "$is_valid" == "false" ]]; then
                    die "Valor para '--spinner' inválido. Recibido: '${val}'. Opciones válidas: ${VALID_SPINNERS[*]}."
                fi
                spinner_type="$val"
                ;;
            --title) title="$val" ;;
            -a|--align)
                case "${val,,}" in
                    left|right) align="${val,,}" ;;
                    *) die "Valor para '--align' inválido. Recibido: '${val}'. Literales esperados: left, right." ;;
                esac
                ;;
            --timeout)
                val="${val%s}"
                [[ ! "$val" =~ ^[0-9]+$ ]] && die "Valor para '--timeout' inválido. Recibido: '${val}'. Literal esperado: Entero >= 0."
                timeout="$val"
                ;;
            --spin-delay)
                [[ ! "$val" =~ ^[0-9]+(\.[0-9]+)?$ ]] && die "Valor para '--spin-delay' inválido. Recibido: '${val}'. Literal esperado: Número."
                spin_delay="$val"
                ;;
            --live-output.max-lines)
                [[ ! "$val" =~ ^[1-9][0-9]*$ ]] && die "Valor para '--live-output.max-lines' inválido. Recibido: '${val}'. Literal esperado: Entero positivo > 0."
                lo_max_lines="$val"
                ;;
            --title.padding|--live-output.padding)
                [[ ! "$val" =~ ^[0-9]+([[:space:]]+[0-9]+){0,3}$ ]] && die "Padding inválido en '${base_key}'. Recibido: '${val}'."
                [[ "$base_key" == "--title.padding" ]] && t_padding="$val"
                [[ "$base_key" == "--live-output.padding" ]] && lo_padding="$val"
                ;;
            --spinner.foreground|--spinner.background|--title.foreground|--title.background|--live-output.foreground|--live-output.background)
                if ! is_valid_color "$val"; then
                    die "color '${val}' no encontrado, colores disponibles: $(_list_color_names)"
                fi
                case "$base_key" in
                    --spinner.foreground) c_spinner_fg="$val" ;;
                    --spinner.background) c_spinner_bg="$val" ;;
                    --title.foreground)   c_title_fg="$val" ;;
                    --title.background)   c_title_bg="$val" ;;
                    --live-output.foreground) lo_fg="$val" ;;
                    --live-output.background) lo_bg="$val" ;;
                esac
                ;;
        esac
    done

    if [[ ${#user_cmd[@]} -eq 0 ]]; then
        die "Se esperaba <command> después del separador '--'."
    fi

    local cmd_name="${user_cmd[0]}"
    if ! type "$cmd_name" &>/dev/null; then
        printf '%s\n' "${ESC}[31m[!] Error: \"$cmd_name\" no existe en este proceso.${ESC}[0m" >&2
        printf '%s\n' "    Si \"spin\" corre como script externo (no via 'source')," >&2
        printf '%s\n' "    las funciones de tu shell no son visibles." >&2
        printf '%s\n' "    Solución: export -f $cmd_name" >&2
        return 127
    fi

    if [[ "$(type -t "$cmd_name")" == "function" ]]; then
        export -f "$cmd_name" 2>/dev/null
    fi

    local frames=()
    local suffixes=()
    local default_delay=0.1

    case "$spinner_type" in
        line)      frames=("|" "/" "-" "\\"); default_delay=0.08 ;;
        standard)  frames=("[-]" "[/]" "[|]" "[\\]"); default_delay=0.1 ;;
        process)   frames=("[|]" "[/]" "[-]" "[\\]"); suffixes=("." ".." "..." "   "); default_delay=0.12 ;;
        bar)       frames=("[    ]" "[=   ]" "[==  ]" "[=== ]" "[====]" "[ ===]" "[  ==]" "[   =]" "[    ]"); default_delay=0.1 ;;
        minidot)   frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏"); default_delay=0.08 ;;
        jump)      frames=("⢄" "⢂" "⢁" "⡁" "⡈" "⡐" "⡠"); default_delay=0.1 ;;
        pulse)     frames=("█" "▓" "▒" "░"); default_delay=0.1 ;;
        points)    frames=("." ".." "..." "   "); default_delay=0.2 ;;
        globe)     frames=("🌍" "🌎" "🌏"); default_delay=0.2 ;;
        moon)      frames=("🌑" "🌒" "🌓" "🌔" "🌕" "🌖" "🌗" "🌘"); default_delay=0.1 ;;
        monkey)    frames=("🙈" "🙉" "🙊"); default_delay=0.3 ;;
        meter)     frames=("▱▱▱" "▰▱▱" "▰▰▱" "▰▰▰" "▰▰▱" "▰▱▱"); default_delay=0.1 ;;
        hamburger) frames=("☲" "☴" "☵" "☱" "☳"); default_delay=0.15 ;;
        dot|*)     frames=("⣾" "⣽" "⣻" "⢿" "⡿" "⣟" "⣯" "⣷"); default_delay=0.08 ;;
    esac

    local delay="${spin_delay:-$default_delay}"
    local total_frames=${#frames[@]}
    local total_suffixes=${#suffixes[@]}

    local s_spinner s_title s_live reset
    s_spinner="$(make_ansi "$c_spinner_fg" "$c_spinner_bg")"
    s_title="$(make_ansi "$c_title_fg" "$c_title_bg")"
    s_live="$(make_ansi "$lo_fg" "$lo_bg")"
    reset="${ESC}[0m"

    local t_pad_t=0 t_pad_r=0 t_pad_b=0 t_pad_l=0
    read -ra _pv <<< "$t_padding"
    case "${#_pv[@]}" in
        1) t_pad_t="${_pv[0]}"; t_pad_r="${_pv[0]}"; t_pad_b="${_pv[0]}"; t_pad_l="${_pv[0]}" ;;
        2) t_pad_t="${_pv[0]}"; t_pad_b="${_pv[0]}"; t_pad_r="${_pv[1]}"; t_pad_l="${_pv[1]}" ;;
        3) t_pad_t="${_pv[0]}"; t_pad_r="${_pv[1]}"; t_pad_l="${_pv[1]}"; t_pad_b="${_pv[2]}" ;;
        4) t_pad_t="${_pv[0]}"; t_pad_r="${_pv[1]}"; t_pad_b="${_pv[2]}"; t_pad_l="${_pv[3]}" ;;
    esac

    local lo_pad_t=0 lo_pad_r=0 lo_pad_b=0 lo_pad_l=0
    read -ra _pv <<< "$lo_padding"
    case "${#_pv[@]}" in
        1) lo_pad_t="${_pv[0]}"; lo_pad_r="${_pv[0]}"; lo_pad_b="${_pv[0]}"; lo_pad_l="${_pv[0]}" ;;
        2) lo_pad_t="${_pv[0]}"; lo_pad_b="${_pv[0]}"; lo_pad_r="${_pv[1]}"; lo_pad_l="${_pv[1]}" ;;
        3) lo_pad_t="${_pv[0]}"; lo_pad_r="${_pv[1]}"; lo_pad_l="${_pv[1]}"; lo_pad_b="${_pv[2]}" ;;
        4) lo_pad_t="${_pv[0]}"; lo_pad_r="${_pv[1]}"; lo_pad_b="${_pv[2]}"; lo_pad_l="${_pv[3]}" ;;
    esac

    local t_indent=""; for (( _p=0; _p<t_pad_l; _p++ )); do t_indent+=" "; done
    local lo_indent=""; for (( _p=0; _p<lo_pad_l; _p++ )); do lo_indent+=" "; done

    local temp_out temp_err temp_combined
    temp_out=$(mktemp)
    temp_err=$(mktemp)
    [[ "$live_output" == "true" ]] && temp_combined=$(mktemp)

    local stty_orig
    stty_orig=$(stty -g < /dev/tty 2>/dev/null)
    stty -echo -icanon -isig < /dev/tty 2>/dev/null
    printf '%s' "${ESC}[?25l" >&2

    if [[ "$live_output" == "true" ]]; then
        "${user_cmd[@]}" > "$temp_combined" 2>&1 &
    else
        "${user_cmd[@]}" > "$temp_out" 2> "$temp_err" &
    fi

    local pid=$!
    local start_time; start_time=$(date +%s)

    function _spin_cleanup() {
        if [[ -n "$stty_orig" ]]; then stty "$stty_orig" < /dev/tty 2>/dev/null; fi
        if [[ "$live_output" == "true" ]]; then
            printf "${ESC}[J" >&2
            cat "$temp_combined" > "$temp_out" 2>/dev/null
            : > "$temp_err"
        else
            printf "%s%s" "${CR}" "${ESC}[K" >&2
        fi
        printf '%s' "${ESC}[?25h" >&2
        rm -f "$temp_out" "$temp_err" "$temp_combined"
    }

    trap 'kill "$pid" 2>/dev/null; _spin_cleanup; exit 130' SIGINT TERM

    local frame_lines=0
    if [[ "$live_output" == "true" ]]; then
        frame_lines=$(( t_pad_t + 1 + t_pad_b + lo_pad_t + lo_max_lines + lo_pad_b ))
        for (( _p=0; _p<frame_lines; _p++ )); do printf "\n" >&2; done
        printf "${ESC}[%dA" "$frame_lines" >&2
    fi

    local i=0

    while kill -0 "$pid" 2>/dev/null; do
        if [[ $timeout -gt 0 ]]; then
            local now=$(date +%s)
            if (( now - start_time >= timeout )); then
                kill "$pid" 2>/dev/null
                break
            fi
        fi

        local frame="${frames[$i]}"
        local suffix=""
        (( total_suffixes > 0 )) && suffix="${suffixes[$((i % total_suffixes))]}"

        local spin_line
        if [[ -z "$title" ]]; then
            spin_line="${s_spinner}${frame}${reset}"
        elif [[ "$align" == "right" ]]; then
            spin_line="${s_title}${title}${suffix}${reset} ${s_spinner}${frame}${reset}"
        else
            spin_line="${s_spinner}${frame}${reset} ${s_title}${title}${reset}${suffix}"
        fi

        if [[ "$live_output" == "true" ]]; then
            for (( _p=0; _p<t_pad_t; _p++ )); do printf "${ESC}[K\n" >&2; done
            printf "%s%s%s\n" "${t_indent}" "${spin_line}" "${ESC}[K" >&2
            for (( _p=0; _p<t_pad_b; _p++ )); do printf "${ESC}[K\n" >&2; done
            
            for (( _p=0; _p<lo_pad_t; _p++ )); do printf "${ESC}[K\n" >&2; done
            
            local lo_lines=()
            mapfile -t lo_lines < <(tail -n "$lo_max_lines" "$temp_combined" 2>/dev/null)
            
            for (( j=0; j<lo_max_lines; j++ )); do
                if (( j < ${#lo_lines[@]} )); then
                    printf "%s%s%s%s%s\n" "${lo_indent}" "${s_live}" "${lo_lines[$j]}" "${reset}" "${ESC}[K" >&2
                else
                    printf "${ESC}[K\n" >&2
                fi
            done
            
            for (( _p=0; _p<lo_pad_b; _p++ )); do printf "${ESC}[K\n" >&2; done
            
            printf "${ESC}[%dA" "$frame_lines" >&2
        else
            printf "%s%s%s%s" "${CR}" "${t_indent}" "${spin_line}" "${ESC}[K" >&2
        fi

        (( i = (i + 1) % total_frames ))
        
        sleep "$delay"
        while IFS= read -rsn1 -t 0.001 _trash_key < /dev/tty 2>/dev/null; do
            if [[ "$_trash_key" == $'\x03' || "$_trash_key" == $'\x04' ]]; then
                kill "$pid" 2>/dev/null
                _spin_cleanup
                return 130
            fi
        done
    done

    wait "$pid" 2>/dev/null
    local exit_code=$?

    if [[ "$live_output" == "true" ]]; then
        local flush_frames=6
        local _ff
        for (( _ff=0; _ff<flush_frames; _ff++ )); do
            
            for (( _p=0; _p<t_pad_t; _p++ )); do printf "${ESC}[K\n" >&2; done

            local _fsl
            if [[ -z "$title" ]]; then
                _fsl="${s_spinner}${frames[$((i % total_frames))]}${reset}"
            elif [[ "$align" == "right" ]]; then
                _fsl="${s_title}${title}${reset} ${s_spinner}${frames[$((i % total_frames))]}${reset}"
            else
                _fsl="${s_spinner}${frames[$((i % total_frames))]}${reset} ${s_title}${title}${reset}"
            fi
            printf "%s%s%s\n" "${t_indent}" "${_fsl}" "${ESC}[K" >&2

            for (( _p=0; _p<t_pad_b; _p++ )); do printf "${ESC}[K\n" >&2; done
            for (( _p=0; _p<lo_pad_t; _p++ )); do printf "${ESC}[K\n" >&2; done

            local _fl=()
            mapfile -t _fl < <(tail -n "$lo_max_lines" "$temp_combined" 2>/dev/null)
            for (( j=0; j<lo_max_lines; j++ )); do
                if (( j < ${#_fl[@]} )); then
                    printf "%s%s%s%s%s\n" "${lo_indent}" "${s_live}" "${_fl[$j]}" "${reset}" "${ESC}[K" >&2
                else
                    printf "${ESC}[K\n" >&2
                fi
            done

            for (( _p=0; _p<lo_pad_b; _p++ )); do printf "${ESC}[K\n" >&2; done
            
            printf "${ESC}[%dA" "$frame_lines" >&2
            sleep 0.08
        done
    fi

    _spin_cleanup
    trap - SIGINT TERM

    if [[ "$show_output" == "true" ]]; then
        cat "$temp_out"
        cat "$temp_err" >&2
    elif [[ "$show_error" == "true" && $exit_code -ne 0 ]]; then
        cat "$temp_out"
        cat "$temp_err" >&2
    else
        [[ "$show_stdout" == "true" ]] && cat "$temp_out"
        [[ "$show_stderr" == "true" ]] && cat "$temp_err" >&2
    fi

    rm -f "$temp_out" "$temp_err" "$temp_combined"
    return $exit_code
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    cmd_spin "${@}"
fi
